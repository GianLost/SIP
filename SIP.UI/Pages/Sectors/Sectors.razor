@page "/sectors"

@using MudBlazor
@using MudBlazor.Utilities
@using SIP.UI.Components.Dialogs.Sectors
@using SIP.UI.Components.Tooltips
@using SIP.UI.Domain.DTOs.Default.Pagination
@using SIP.UI.Domain.DTOs.Sectors
@using SIP.UI.Domain.DTOs.Sectors.Pagination
@using SIP.UI.Domain.DTOs.Sectors.Request
@using SIP.UI.Domain.DTOs.Users.Pagination
@using SIP.UI.Domain.DTOs.Users.Request
@using SIP.UI.Domain.Helpers.PhoneFormatting
@using SIP.UI.Domain.Helpers.Strings
@using SIP.UI.Domain.Services.Sectors
@using SIP.UI.Models.Sectors
@using SIP.UI.Models.Users

@inject SectorService _sectorService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Título direcional *@
<MudStack Class="main-page-title">
    <MudText Typo="Typo.h6">SECRETARIAS <span>| INÍCIO</span></MudText>
</MudStack>

@* Container principal *@
<MudContainer 
    MaxWidth="MaxWidth.Large" 
    Class="my-8 px-4">

    @* Bloco para o FAB button *@
    <MudStack 
        Row="true" 
        AlignItems="AlignItems.Stretch" 
        Class="mb-3 ml-3">

        @* FAB button de (Adicionar secretaria) *@
        <MudButton 
            Variant="Variant.Filled" 
            Color="Color.Primary" 
            OnClick="ShowAddDialog" 
            Class="@GetButtonClass()">

            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Medium" />

            <span class="button-text-label">Nova Secretaria</span>

        </MudButton>

    </MudStack>

    @* Componente de organização para a tabela *@
    <MudPaper 
        Class="pa-4 ma-2" 
        Elevation="1">

        @* Tabela *@
        <MudTable 
            T="SectorListItemDTO" 
            ServerData="LoadServerData"
            Dense="true" 
            Hover="true" 
            Bordered="false" 
            @ref="table" 
            RowsPerPage="pageSize" 
            LoadingProgressColor="Color.Primary" 
            Loading="@isLoading" 
            SortLabel="sortLabel" 
            Elevation="0" 
            MultiSelection="true" 
            SelectedItems="_selectedSectors"
            SelectedItemsChanged="OnSelectedItemsChanged">

            @* Barra superior da tabela contendo o campo de filtragem e os botões de exportação *@
            <ToolBarContent>

                @* Componente de organização da barra de recursos da tabela *@
                <MudStack 
                    Style="width: 100%; margin-left: -0.75rem;" 
                    Row="true" 
                    AlignItems="AlignItems.Center" 
                    Justify="Justify.SpaceBetween">

                    @* Componente de organização do menu de opções *@
                    <MudStack 
                        Row="true" 
                        AlignItems="AlignItems.Center">

                        @* Condição para exibição dos meunus de opções *@
                        @if (_selectedSectors.Any())
                        {
                            @* Tooltip customizado para dicas de funcionamento do componente *@
                            <AppTooltip Title="Menu de opções"
                                        Description="@($"Clique para expandir o menu e operar sob {_selectedSectors.Count} secretaria(s) selecionada(s)")"
                                        Icon="@Icons.Material.Filled.SettingsApplications"
                                        Placement="Placement.Right">

                                @* Menu de opções *@
                                <MudMenu 
                                    Dense="true" 
                                    Icon="@Icons.Material.Filled.SettingsApplications" 
                                    Color="Color.Primary" 
                                    AnchorOrigin="Origin.BottomRight" 
                                    TransformOrigin="Origin.TopRight">

                                    @* Ações visíveis apenas quando exatamente UMA secretaria é selecionada *@
                                    @if (_selectedSectors.Count == 1)
                                    {
                                        @* Botão de edição *@
                                        <MudMenuItem 
                                            OnClick="@(() => ShowEditDialog(_selectedSectors.First()))">

                                            <MudStack 
                                                Row="true" 
                                                AlignItems="AlignItems.Center">

                                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Editar</MudText>

                                            </MudStack>

                                        </MudMenuItem>

                                        <MudDivider Class="my-2" />

                                        @* Botão de exclusão *@
                                        <MudMenuItem 
                                            OnClick="@(() => ShowDeleteDialog(_selectedSectors.First()))" 
                                            Style="color: var(--mud-palette-error);">

                                            <MudStack 
                                                Row="true" 
                                                AlignItems="AlignItems.Center">

                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Excluir</MudText>

                                            </MudStack>

                                        </MudMenuItem>
                                    }
                                    @* Ação visível apenas quando MÚLTIPLAS secretarias são selecionadas *@
                                    @if (_selectedSectors.Count > 1)
                                    {
                                        @* Botão de múltipla exclusão *@
                                        <MudMenuItem 
                                            OnClick="ShowDeleteSelectedSectorsDialog" 
                                            Style="color: var(--mud-palette-error);">

                                            <MudStack 
                                                Row="true" 
                                                AlignItems="AlignItems.Center">

                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Excluir</MudText>

                                            </MudStack>

                                        </MudMenuItem>
                                    }
                                </MudMenu>

                            </AppTooltip>
                        }
                    </MudStack>

                    @* Componente de organização do campo de filtragem por busca *@
                    <MudStack 
                        Row="true" 
                        AlignItems="AlignItems.Center" 
                        Spacing="0">

                        @* Componente de filtragem de registros por busca *@
                        <MudTextField 
                            T="string" 
                            ValueChanged="@OnSearch" 
                            Immediate="false"
                            DebounceInterval="300" 
                            Placeholder="digite sua busca..." 
                            Adornment="Adornment.Start" 
                            AdornmentIcon="@Icons.Material.Filled.Search" 
                            IconSize="Size.Medium" 
                            Class="m-auto" 
                            Clearable="true" 
                            Style="max-width: 300px;" />

                        @* Tooltip customizado para dicas de funcionamento do componente *@
                        <AppTooltip Title="Exportar para"
                                    Description="Utilize este menu para exportar os dados exibidos na tabela para formatos CSV ou PDF."
                                    Icon="@Icons.Material.Filled.FilePresent">

                            @* Componente do menu de exportação de registros da tabela *@
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     Color="Color.Primary"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight">

                                <MudMenuItem OnClick="ExportToCsv">Exportar CSV</MudMenuItem>
                                <MudMenuItem OnClick="ExportToPdf">Exportar PDF</MudMenuItem>

                            </MudMenu>

                        </AppTooltip>

                    </MudStack>

                </MudStack>

            </ToolBarContent>

            @* Cabeçalho da Tabela *@
            <HeaderContent>

                <MudTh></MudTh>

                <MudTh 
                    Style="font-weight: bold;">

                    <MudTableSortLabel 
                        SortLabel="name" 
                        InitialDirection="SortDirection.Ascending" 
                        SortBy="new Func<SectorListItemDTO, object>(x => x.Name)">
                            Nome
                    </MudTableSortLabel>

                </MudTh>

                <MudTh 
                    Style="font-weight: bold;">

                    <MudTableSortLabel 
                        SortLabel="acronym" 
                        SortBy="new Func<SectorListItemDTO, object>(x => x.Acronym)">
                            Sigla
                    </MudTableSortLabel>

                </MudTh>

                <MudTh 
                    Style="font-weight: bold;">
                    Telefone
                </MudTh>

            </HeaderContent>

            @* Corpo da tabela *@
            <RowTemplate 
                Context="sector">

                @* Componente de exibição de registros relacionais *@
                <MudTd 
                    Class="user-toggle-cell">

                    <div class="user-toggle-wrapper">
                        @if (_selectedSectors.Any(s => s.Id == sector.Id))
                        {
                            @* Tooltip customizado para dicas de funcionamento do componente *@
                            <AppTooltip 
                                Title="Exibir usuários"
                                Description="Clique para expandir a visualização de usuários vinculados a este setor."
                                Icon="@Icons.Material.Filled.People"
                                Placement="Placement.Left">

                                @* Botão de exibição dos usuários relacionados ao setor *@
                                <MudIconButton 
                                    Icon="@(openSectorIds.Contains(sector.Id) ? Icons.Material.Filled.People : Icons.Material.Filled.PeopleOutline)"
                                    Color="Color.Primary" 
                                    Size="Size.Small" 
                                    Class="p-0 m-0" 
                                    OnClick="@(() => ToggleShowUsers(sector))" />

                            </AppTooltip>
                        }
                    </div>

                </MudTd>

                <MudTd DataLabel="Nome">@sector.Name.ToUppercase()</MudTd>
                <MudTd DataLabel="Sigla">@sector.Acronym.ToUppercase()</MudTd>
                <MudTd DataLabel="Telefone">@PhoneExtensions.FormatPhoneNumber(@sector.Phone)</MudTd>

            </RowTemplate>

            @* Componente para exibição dos registros relacionados à entidade pai. *@
            <ChildRowContent 
                Context="sectorDetail">

                @if (openSectorIds.Contains(sectorDetail.Id))
                {
                    var users = sectorUsers.TryGetValue(sectorDetail.Id, out var u) ? u : new List<UserBasicListDTO>();

                    <MudTr>

                        <td colspan="5">

                            @* card para organização do ChildRowContent *@
                            <MudCard 
                                Elevation="3">

                                @* Cabeçalho com informações primárias do usuário *@
                                <MudCardHeader>

                                    <CardHeaderContent>

                                        <MudStack 
                                            Row="true" 
                                            AlignItems="AlignItems.Center">

                                            <MudText Typo="Typo.body1" Style="font-weight: bold;">Usuários de:</MudText>
                                            <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight: bold;">@sectorDetail.Name.ToUppercase()</MudText>

                                        </MudStack>

                                    </CardHeaderContent>

                                </MudCardHeader>

                                <MudCardContent 
                                    Class="pa-0">

                                    @* Componente de organização da tabela de relacionamentos *@
                                    <MudTable 
                                        T="UserBasicListDTO" 
                                        Items="users" 
                                        Bordered="false" 
                                        Hover="true" 
                                        Elevation="0">

                                        @* Cabeçalho da tabela de usuários *@
                                        <HeaderContent>
                                            <MudTh Style="font-weight: bold;">Status</MudTh>
                                            <MudTh Style="font-weight: bold;">MASP</MudTh>
                                            <MudTh Style="font-weight: bold;">Nome</MudTh>
                                            <MudTh Style="font-weight: bold;">Login</MudTh>
                                            <MudTh Style="font-weight: bold;">Secretaria</MudTh>
                                        </HeaderContent>

                                        @* Corpo da tabela de usuários*@
                                        <RowTemplate 
                                            Context="user">

                                            <MudTd 
                                                DataLabel="Status">

                                                @* Ícone de status do usuário *@
                                                <ChildContent>
                                                    <MudChip T="string"
                                                             Color="@(user.Status ? Color.Success : Color.Error)"
                                                             Variant="Variant.Filled"
                                                             Size="Size.Small"
                                                             Class="status-chip">
                                                        @(user.Status ? "Ativo" : "Inativo")
                                                    </MudChip>
                                                </ChildContent>

                                            </MudTd>

                                            <MudTd DataLabel="MASP">@user.Masp</MudTd>
                                            <MudTd DataLabel="Nome">@user.Name.ToUppercase()</MudTd>
                                            <MudTd DataLabel="Login">@user.Login</MudTd>
                                            <MudTd DataLabel="Login">@user.Sector</MudTd>

                                        </RowTemplate>

                                        <NoRecordsContent>
                                            <MudText>Nenhum usuário vinculado...</MudText>
                                        </NoRecordsContent>

                                    </MudTable>

                                </MudCardContent>

                            </MudCard>

                        </td>

                    </MudTr>

                }

            </ChildRowContent>

            @* Conteúdo para exibição quando não há registros encontrados *@
            <NoRecordsContent>
                <MudText Class="pa-6 text-center mud-text-secondary">Nenhuma secretaria encontrada para exibir.</MudText>
            </NoRecordsContent>

            @* Conteúdo exibido enquanto está ocorrendo o carregamento dos registros *@
            <LoadingContent>
                <MudText Class="pa-6 text-center mud-text-secondary">Carregando secretarias, por favor aguarde...</MudText>
            </LoadingContent>

            @* Componente Mudblazor para inserir o seletor de registros por página da tabela. *@
            <PagerContent>
                <MudTablePager RowsPerPageString="Registros por página:" PageSizeOptions="new int[] { 15, 25, 50, 100 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>

</MudContainer>

@code {

    private MudTable<SectorListItemDTO>? table;

    private HashSet<SectorListItemDTO> _selectedSectors = new();

    // Dicionário para armazenar usuários carregados por setor
    private Dictionary<Guid, List<UserBasicListDTO>> sectorUsers = new();

    private bool isLoading = false;
    private int pageSize = 15;
    private string searchString = string.Empty;
    private string? lastSortLabel;
    private bool _isModalOpen = false;

    // track which sector child rows are currently open (by Id)
    private readonly HashSet<Guid> openSectorIds = new();

    // track previous selected ids to detect additions/removals reliably
    private HashSet<Guid> _previousSelectedIds = new();

    /// <summary>
    /// Fornece a classe CSS para o botão FAB com base no estado do modal.
    /// </summary>
    /// <returns></returns>
    private string GetButtonClass() =>
        $"mud-elevation-3 animated-fab-button-manual-icon {(_isModalOpen ? "force-expanded-button" : "")}";

    protected override void OnInitialized() =>
        _selectedSectors.Clear();

    /// <summary>
    /// Loads paginated sector data from the server for MudTable component.
    /// </summary>
    /// <param name="state">The table state (page, sorting, etc).</param>
    /// <param name="cancellationToken">Cancellation token.</param>
    /// <returns>TableData with sectors and total count.</returns>
    private async Task<TableData<SectorListItemDTO>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        isLoading = true;
        StateHasChanged();

        pageSize = state.PageSize;
        string? sortLabel = state.SortLabel;

        if (string.IsNullOrWhiteSpace(sortLabel))
        {
            if (state.SortDirection != SortDirection.None)
                sortLabel = lastSortLabel ?? "Name";
            else
                sortLabel = "Name";
        }

        lastSortLabel = sortLabel;

        try
        {
            PagedResultDTO<SectorListItemDTO>? sectors = await _sectorService.GetPagedAsync(
                state.Page + 1,
                state.PageSize,
                sortLabel,
                GetSortDirectionString(state.SortDirection),
                searchString);

            return new TableData<SectorListItemDTO>
            {
                Items = sectors!.Items,
                TotalItems = sectors.TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar dados: {ex.Message}", Severity.Error);
            return new TableData<SectorListItemDTO> { Items = [], TotalItems = 0 };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Toggles the visibility of related users for a sector.
    /// </summary>
    /// <param name="sector">The sector to toggle.</param>
    private async Task ToggleShowUsers(SectorListItemDTO sector)
    {
        if (openSectorIds.Contains(sector.Id))
        {
            openSectorIds.Remove(sector.Id);
            sectorUsers.Remove(sector.Id);
        }
        else
        {
            // collapse all others
            foreach (var id in openSectorIds.ToList())
            {
                openSectorIds.Remove(id);
                sectorUsers.Remove(id);
            }
            // open this one
            openSectorIds.Add(sector.Id);
            if (!sectorUsers.ContainsKey(sector.Id))
                sectorUsers[sector.Id] = await _sectorService.GetUsersBySectorAsync(sector.Id);
        }
        StateHasChanged();
    }

    private Task OnSelectedItemsChanged(HashSet<SectorListItemDTO> selected)
    {
        // new selection ids (snapshot of the passed set)
        var newIds = new HashSet<Guid>(selected.Select(s => s.Id));

        // removed ids = previously selected but not in new selection
        var removedIds = _previousSelectedIds.Except(newIds).ToList();
        foreach (var id in removedIds)
        {
            if (openSectorIds.Contains(id))
            {
                openSectorIds.Remove(id);
                sectorUsers.Remove(id);
            }
        }

        // added ids = newly selected
        var addedIds = newIds.Except(_previousSelectedIds).ToList();
        if (addedIds.Any())
        {
            // keep only last-added open: collapse others
            var lastAddedId = addedIds.Last();
            foreach (var id in openSectorIds.ToList())
            {
                if (id != lastAddedId)
                {
                    openSectorIds.Remove(id);
                    sectorUsers.Remove(id);
                }
            }
        }

        // update your selection references
        _selectedSectors = selected;           // still useful for UI/menu
        _previousSelectedIds = newIds;        // update snapshot

        // if selection became empty, ensure all child rows closed
        if (!newIds.Any())
        {
            openSectorIds.Clear();
            sectorUsers.Clear();
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Updates the last used sort label.
    /// </summary>
    /// <param name="label">The sort label.</param>
    private void OnSortLabelChanged(string? label) =>
        lastSortLabel = label;

    /// <summary>
    /// Converts MudBlazor SortDirection to string.
    /// </summary>
    /// <param name="direction">Sort direction.</param>
    /// <returns>"asc", "desc" or empty string.</returns>
    private string GetSortDirectionString(SortDirection direction) =>
        direction switch
        {
            SortDirection.Ascending => "asc",
            SortDirection.Descending => "desc",
            _ => string.Empty
        };

    /// <summary>
    /// Handles search input and reloads table data.
    /// </summary>
    /// <param name="text">Search text.</param>
    private async Task OnSearch(string text)
    {
        searchString = text;

        if (table is not null)
            await table.ReloadServerData();
    }

    @* ------- Comportamento dos Diálogos ------- *@

    /// <summary>
    /// Shows the dialog to add a new sector.
    /// </summary>
    private async Task ShowAddDialog()
    {
        _isModalOpen = true;

        DialogParameters<SectorDialog> parameters = new();
        parameters.Add(x => x.Sector, new SectorCreateDTO());

        IDialogReference dialog = await DialogService.ShowAsync<SectorDialog>(string.Empty, parameters);
        DialogResult? result = await dialog.Result;

        _isModalOpen = false;

        if (result is not null && !result.Canceled)
        {
            var createdSector = result.Data as SectorCreateDTO;

            if (createdSector != null)
            {
                try
                {
                    await _sectorService.CreateAsync(createdSector);
                    Snackbar.Add("Secretaria criada com sucesso!", Severity.Success);

                    if (table is not null)
                        await table.ReloadServerData();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao criar secretaria: {ex.Message}", Severity.Error);
                }
            }
        }
        else
        {
            Snackbar.Add($"Inserção de setor cancelada.", Severity.Info);
        }
    }

    /// <summary>
    /// Shows the dialog to edit an existing sector.
    /// </summary>
    /// <param name="sector">Sector to edit.</param>
    private async Task ShowEditDialog(SectorListItemDTO sector)
    {
        DialogParameters<SectorDialog> parameters = new();

        parameters.Add(x => x.Sector, new SectorUpdateDTO
        {
            Id = sector.Id,
            Name = sector.Name,
            Acronym = sector.Acronym,
            Phone = sector.Phone
        });

        IDialogReference dialog = await DialogService.ShowAsync<SectorDialog>(string.Empty, parameters);
        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            var updatedSector = result.Data as SectorUpdateDTO;

            if (updatedSector != null)
            {
                try
                {
                    await _sectorService.UpdateAsync(updatedSector);
                    Snackbar.Add("Secretaria atualizada com sucesso!", Severity.Success);

                    if (table is not null)
                        await table.ReloadServerData();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao atualizar secretaria: {ex.Message}", Severity.Error);
                }
            }
        }
        else
        {
            Snackbar.Add("Edição de setor cancelada.", Severity.Info);
        }
    }

    /// <summary>
    /// Shows the dialog to delete a sector.
    /// </summary>
    /// <param name="sector">Sector to delete.</param>
    private async Task ShowDeleteDialog(SectorListItemDTO sector)
    {
        DialogParameters<SectorDeleteDialog> parameters = new();

        parameters.Add(x => x.SectorToDelete, sector);

        IDialogReference dialog = await DialogService.ShowAsync<SectorDeleteDialog>(string.Empty, parameters);

        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await _sectorService.DeleteAsync(sector.Id);

                Snackbar.Add("Secretaria excluída com sucesso!", Severity.Success);

                if (table is not null)
                    await table.ReloadServerData();
            }
            catch (InvalidOperationException ex)
            {
                Snackbar.Add($"Erro ao excluir secretaria: {ex.Message}", Severity.Error);
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add($"Erro de comunicação: {ex.Message}", Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Ocorreu um erro inesperado: {ex.Message}", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Exclusão de setor cancelada.", Severity.Info);
        }
    }

    /// <summary>
    /// Shows a snackbar multiple delete is not implemented.
    /// </summary>
    private void ShowDeleteSelectedSectorsDialog()
    {
        Snackbar.Add("A Exclusão de múltiplos registros ainda não foi implementada.", Severity.Info);
    }

    /// <summary>
    /// Shows a snackbar indicating CSV export is not implemented.
    /// </summary>
    private void ExportToCsv()
    {
        Snackbar.Add("Exportação para CSV ainda não implementada.", Severity.Info);
    }

    /// <summary>
    /// Shows a snackbar indicating PDF export is not implemented.
    /// </summary>
    private void ExportToPdf()
    {
        Snackbar.Add("Exportação para PDF ainda não implementada.", Severity.Info);
    }
}