@page "/users"

@using MudBlazor
@using MudBlazor.Utilities
@using SIP.UI.Components.Dialogs.Users
@using SIP.UI.Components.Dialogs.Users.Configurations
@using SIP.UI.Components.Tooltips
@using SIP.UI.Domain.DTOs.Default.Pagination
@using SIP.UI.Domain.DTOs.Protocols.Pagination
@using SIP.UI.Domain.DTOs.Users
@using SIP.UI.Domain.DTOs.Users.Configurations
@using SIP.UI.Domain.DTOs.Users.Pagination
@using SIP.UI.Domain.DTOs.Users.Request
@using SIP.UI.Domain.Enums
@using SIP.UI.Domain.Helpers.DataFormatting.DateTimes
@using SIP.UI.Domain.Helpers.Strings
@using SIP.UI.Domain.Services.Protocols
@using SIP.UI.Domain.Services.Users
@using SIP.UI.Models.Protocols
@using SIP.UI.Models.Sectors
@using SIP.UI.Models.Users

@inject UserService _userService
@inject ProtocolService _protocolService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Título direcional *@
<MudStack Class="main-page-title">
    <MudText Typo="Typo.h6">USUÁRIOS <span>| INÍCIO</span></MudText>
</MudStack>

@* Container principal *@
<MudContainer MaxWidth="MaxWidth.Large" Class="my-8 px-4">

    @* Bloco para o FAB button *@
    <MudStack 
        Row="true" 
        AlignItems="AlignItems.Stretch" 
        Class="mb-3 ml-3">

        @* FAB button de (Adicionar usuário) *@
        <MudButton 
            Variant="Variant.Filled" 
            Color="Color.Primary" 
            OnClick="ShowAddDialog" 
            Class="@GetButtonClass()">

            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Medium" />

            <span class="button-text-label">Novo Usuário</span>

        </MudButton>

    </MudStack>

    @* Componente de organização para a tabela *@
    <MudPaper 
        Class="pa-4 ma-2" 
        Elevation="1">

        @* Tabela *@
        <MudTable 
            T="UserListItemDTO" 
            ServerData="LoadServerData"
            Dense="true" 
            Hover="true" 
            Bordered="false"
            @ref="table" 
            RowsPerPage="pageSize" 
            LoadingProgressColor="Color.Primary" 
            SortLabel="sortLabel" 
            Loading="@isLoading" 
            Elevation="0" 
            MultiSelection="true"
            SelectedItems="_selectedUsers"
            SelectedItemsChanged="OnSelectedItemsChanged">

            @* Barra superior da tabela contendo o campo de filtragem e os botões de exportação *@
            <ToolBarContent>

                @* Componente de organização da barra de recursos da tabela *@
                <MudStack 
                    Style="width: 100%; margin-left: -0.75rem;" 
                    Row="true" 
                    AlignItems="AlignItems.Center" 
                    Justify="Justify.SpaceBetween">

                    @* Componente de organização do menu de opções *@
                    <MudStack 
                        Row="true" 
                        AlignItems="AlignItems.Center">

                        @* Condição para exibição dos meunus de opções *@
                        @if (_selectedUsers.Any())
                        {
                            <AppTooltip 
                                Title="Menu de opções"
                                Description="@($"Clique para expandir o menu e operar sob {_selectedUsers.Count} usuário(s) selecionado(s)")"
                                Icon="@Icons.Material.Filled.SettingsApplications"
                                Placement="Placement.Right">

                                @* Menu de opções *@
                                <MudMenu 
                                    Dense="true" 
                                    Icon="@Icons.Material.Filled.SettingsApplications" 
                                    Color="Color.Primary" 
                                    AnchorOrigin="Origin.BottomRight" 
                                    TransformOrigin="Origin.TopRight">

                                    @* Ações visíveis apenas quando exatamente UM usuário é selecionado *@
                                    @if (_selectedUsers.Count == 1)
                                    {
                                        @* Botão de edição *@
                                        <MudMenuItem 
                                            OnClick="@(() => ShowEditBasicDialog(_selectedUsers.First()))">

                                            <MudStack 
                                                Row="true" 
                                                AlignItems="AlignItems.Center">

                                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Editar</MudText>

                                            </MudStack>

                                        </MudMenuItem>

                                        @* Botão de alteração de senha *@
                                        <MudMenuItem 
                                            OnClick="@(() => ShowChangePasswordDialog(_selectedUsers.First()))">

                                            <MudStack 
                                                Row="true" 
                                                AlignItems="AlignItems.Center">

                                                <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Redefinir Senha</MudText>

                                            </MudStack>

                                        </MudMenuItem>

                                        @* Botão de alteração de setor *@
                                        <MudMenuItem 
                                            OnClick="@(() => ShowChangeSectorDialog(_selectedUsers.First()))">

                                            <MudStack 
                                                Row="true" 
                                                AlignItems="AlignItems.Center">

                                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Alterar Setor</MudText>

                                            </MudStack>

                                        </MudMenuItem>

                                        <MudDivider Class="my-2" />

                                        @* Botão de exclusão *@
                                        <MudMenuItem 
                                            OnClick="@(() => ShowDeleteDialog(_selectedUsers.First()))"
                                            Style="color: var(--mud-palette-error);">

                                            <MudStack 
                                                Row="true" 
                                                AlignItems="AlignItems.Center">

                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Excluir</MudText>

                                            </MudStack>

                                        </MudMenuItem>
                                    }
                                    @* Ação visível apenas quando MÚLTIPLOS usuários são selecionados *@
                                    @if (_selectedUsers.Count > 1)
                                    {
                                        @* Botão de múltipla exclusão *@
                                        <MudMenuItem 
                                            OnClick="ShowDeleteSelectedUsersDialog" 
                                            Style="color: var(--mud-palette-error);">

                                            <MudStack 
                                                Row="true" 
                                                AlignItems="AlignItems.Center">

                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">Excluir</MudText>

                                            </MudStack>

                                        </MudMenuItem>
                                    }
                                </MudMenu>
                            </AppTooltip>
                        }
                    </MudStack>

                    @* Componente de organização do campo de filtragem por busca *@
                    <MudStack 
                        Row="true" 
                        AlignItems="AlignItems.Center"
                        Spacing="0">

                        @* Componente de filtragem de registros por busca *@
                        <MudTextField 
                            T="string" 
                            ValueChanged="@OnSearch" 
                            Immediate="false" 
                            DebounceInterval="300" 
                            Placeholder="digite sua busca..." 
                            Adornment="Adornment.Start" 
                            AdornmentIcon="@Icons.Material.Filled.Search" 
                            IconSize="Size.Medium" 
                            Class="m-auto" 
                            Clearable="true" 
                            Style="max-width: 300px;" />

                        @* Tooltip customizado para dicas de funcionamento do componente *@
                        <AppTooltip 
                            Title="Exportar para"
                            Description="Utilize este menu para exportar os dados exibidos na tabela para formatos CSV ou PDF."
                            Icon="@Icons.Material.Filled.FilePresent">

                            @* Componente do menu de exportação de registros da tabela *@
                            <MudMenu 
                                Icon="@Icons.Material.Filled.MoreVert"
                                Color="Color.Primary"
                                AnchorOrigin="Origin.BottomRight"
                                TransformOrigin="Origin.TopRight">

                                <MudMenuItem OnClick="ExportToCsv">Exportar CSV</MudMenuItem>
                                <MudMenuItem OnClick="ExportToPdf">Exportar PDF</MudMenuItem>

                            </MudMenu>

                        </AppTooltip>

                    </MudStack>

                </MudStack>

            </ToolBarContent>

            @* Cabeçalho da Tabela *@
            <HeaderContent>

                <MudTh Style="width: 1%; min-width: 1%; font-weight: bold;"></MudTh>

                <MudTh 
                    Style="width: 10%; min-width: 10%; font-weight: bold;">

                    <MudTableSortLabel 
                        SortLabel="Status" 
                        SortBy="new Func<UserListItemDTO, object>(x => x.Status)">
                            Status
                    </MudTableSortLabel>

                </MudTh>

                <MudTh 
                    Style="width: 10%; min-width: 10%; font-weight: bold;">

                    <MudTableSortLabel 
                        SortLabel="Masp" 
                        InitialDirection="SortDirection.Ascending" 
                        SortBy="new Func<UserListItemDTO, object>(x => x.Masp!)">
                            Masp
                    </MudTableSortLabel>

                </MudTh>

                <MudTh 
                    Style="width: 39%; min-width: 39%; font-weight: bold;">

                    <MudTableSortLabel 
                        SortLabel="Name" 
                        InitialDirection="SortDirection.Ascending" 
                        SortBy="new Func<UserListItemDTO, object>(x => x.Name!)">
                            Nome
                    </MudTableSortLabel>

                </MudTh>

                <MudTh Style="width: 20%; min-width: 20%; font-weight: bold;">

                    <MudTableSortLabel 
                        SortLabel="Login" 
                        InitialDirection="SortDirection.Ascending" 
                        SortBy="new Func<UserListItemDTO, object>(x => x.Login!)">
                            Login
                    </MudTableSortLabel>

                </MudTh>

                <MudTh 
                    Style="width: 20%; min-width: 20%; font-weight: bold;">

                    <MudTableSortLabel 
                        SortLabel="Sector" 
                        InitialDirection="SortDirection.Ascending" 
                        SortBy="new Func<UserListItemDTO, object?>(x => x.Sector)">
                            Secretaria
                    </MudTableSortLabel>

                </MudTh>

            </HeaderContent>

            @* Corpo da tabela *@
            <RowTemplate 
                Context="user">

                @* Componente de exibição de registros relacionais *@
                <MudTd 
                    Class="user-toggle-cell">

                    <div class="user-toggle-wrapper">
                        @if (_selectedUsers.Any(s => s.Id == user.Id))
                        {
                            @* Tooltip customizado para dicas de funcionamento do componente *@
                            <AppTooltip 
                                Title="Exibir protocolos"
                                Description="Clique para expandir a visualização de protocolos vinculados a este usuário."
                                Icon="@Icons.Material.Filled.Book"
                                Placement="Placement.Left">

                                @* Botão de exibição dos protocolos relacionados ao usuário *@
                                <MudIconButton 
                                    Icon="@(openUserIds.Contains(user.Id) ? Icons.Material.Filled.MenuBook : Icons.Material.Outlined.Book)"
                                    Color="Color.Primary" 
                                    Size="Size.Small" 
                                    Class="p-0 m-0" 
                                    OnClick="@(() => ToggleShowProtocols(user))" />

                            </AppTooltip>
                        }

                    </div>

                </MudTd>

                @* Componente de exibição do status de usuário *@
                <MudTd 
                    DataLabel="Status">

                    @* Ícone de status do usuário *@
                    <ChildContent>
                        <MudChip 
                            T="string"
                            Color="@(user.Status ? Color.Success : Color.Error)"
                            Variant="Variant.Filled"
                            Size="Size.Small"
                            Class="status-chip m-0">

                            @(user.Status ? "Ativo" : "Inativo")

                        </MudChip>

                    </ChildContent>

                </MudTd>

                <MudTd DataLabel="Masp">@user.Masp</MudTd>
                <MudTd DataLabel="Name">@user.Name.ToUppercase()</MudTd>
                <MudTd DataLabel="Login">@user.Login</MudTd>
                <MudTd DataLabel="Sector">@user?.Sector.ToUppercase()</MudTd>

            </RowTemplate>

            @* Componente para exibição dos registros relacionados à entidade pai. *@
            <ChildRowContent 
                Context="userDetail">

                @if (openUserIds.Contains(userDetail.Id))
                {
                    var protocols = userProtocols.TryGetValue(userDetail.Id, out var u) ? u : new List<ProtocolBasicListDTO>();

                    <MudTr>

                        <td colspan="8">

                            @* card para organização do ChildRowContent *@
                            <MudCard 
                                Elevation="3">

                                @* Cabeçalho com informações primárias do protocolo *@
                                <MudCardHeader>

                                    <CardHeaderContent>

                                        <MudStack 
                                            Row="true" 
                                            AlignItems="AlignItems.Center">

                                            <MudText Typo="Typo.body1" Style="font-weight: bold;">Protocolos gerados por:</MudText>
                                            <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight: bold;">@userDetail.Name.ToUppercase()</MudText>

                                        </MudStack>

                                    </CardHeaderContent>

                                </MudCardHeader>

                                <MudCardContent 
                                    Class="pa-0">

                                    @* Componente de organização da tabela de relacionamentos *@
                                    <MudTable 
                                        T="ProtocolBasicListDTO" 
                                        Items="protocols" 
                                        Bordered="false" 
                                        Hover="true" 
                                        Dense="true" 
                                        Elevation="0">

                                        @* Cabeçalho da tabela de protocolos *@
                                        <HeaderContent>
                                            <MudTh Style="font-weight: bold;">Status</MudTh>
                                            <MudTh Style="font-weight: bold;">Número</MudTh>
                                            <MudTh Style="font-weight: bold;">Assunto</MudTh>
                                            <MudTh Style="font-weight: bold;">Data de Criação</MudTh>
                                        </HeaderContent>

                                        <RowTemplate 
                                            Context="protocol">

                                            <MudTd DataLabel="Status">@GetStatusChip(protocol.Status)</MudTd>
                                            <MudTd DataLabel="Número">@protocol.Number</MudTd>
                                            <MudTd DataLabel="Assunto">@protocol.Subject.ToUppercase()</MudTd>
                                            <MudTd DataLabel="CriadoEm">@protocol.CreatedAt.ToBrasiliaTimeFormat()</MudTd>

                                        </RowTemplate>

                                        <NoRecordsContent>
                                            <MudText Class="pa-4">Nenhum protocolo vinculado...</MudText>
                                        </NoRecordsContent>

                                    </MudTable>

                                </MudCardContent>

                            </MudCard>

                        </td>

                    </MudTr>

                }

            </ChildRowContent>

            @* Conteúdo para exibição quando não há registros encontrados *@
            <NoRecordsContent>
                <MudText Class="pa-6 text-center mud-text-secondary">Nenhum usuário encontrado para exibir.</MudText>
            </NoRecordsContent>

            @* Conteúdo exibido enquanto está ocorrendo o carregamento dos registros *@
            <LoadingContent>
                <MudText Class="pa-6 text-center mud-text-secondary">Carregando usuários, por favor aguarde...</MudText>
            </LoadingContent>

            @* Componente Mudblazor para inserir o seletor de registros por página da tabela. *@
            <PagerContent>
                <MudTablePager RowsPerPageString="Registros por página:" PageSizeOptions="new int[] { 15, 25, 50, 100 }" />
            </PagerContent>

        </MudTable>

    </MudPaper>

</MudContainer>

@code {

    private MudTable<UserListItemDTO>? table;

    private HashSet<UserListItemDTO> _selectedUsers = new();

    // Dicionário para armazenar usuários carregados por setor
    private Dictionary<Guid, List<ProtocolBasicListDTO>> userProtocols = new();

    private bool isLoading = false;
    private int pageSize = 15;
    private string searchString = string.Empty;
    private bool _isModalOpen = false;

    // track which sector child rows are currently open (by Id)
    private readonly HashSet<Guid> openUserIds = new();

    // track previous selected ids to detect additions/removals reliably
    private HashSet<Guid> _previousSelectedIds = new();

    /// <summary>
    /// Fornece a classe CSS para o botão FAB com base no estado do modal.
    /// </summary>
    /// <returns></returns>
    private string GetButtonClass() =>
        $"mud-elevation-3 animated-fab-button-manual-icon {(_isModalOpen ? "force-expanded-button" : "")}";

    private RenderFragment GetStatusChip(ProtocolStatus status)
    {
        var (text, icon, color) = GetStatusDetails(status);
        return @<MudChip T="string" Label="true" Icon="@icon" Color="@color" Size="Size.Small" Class="rounded-md" Style="width: 6rem;justify-content: center;">@text</MudChip>;
    }

    private (string Text, string Icon, Color Color) GetStatusDetails(ProtocolStatus status) => status switch
    {
        ProtocolStatus.Open => ("Em Aberto", Icons.Material.Filled.FiberNew, Color.Primary),
        ProtocolStatus.SentForReview => ("Enviado", Icons.Material.Filled.Send, Color.Tertiary),
        ProtocolStatus.Received => ("Recebido", Icons.Material.Filled.MarkEmailRead, Color.Success),
        ProtocolStatus.UnderReview => ("Em Análise", Icons.Material.Filled.Search, Color.Warning),
        ProtocolStatus.Approved => ("Aprovado", Icons.Material.Filled.CheckCircle, Color.Success),
        ProtocolStatus.Rejected => ("Rejeitado", Icons.Material.Filled.Cancel, Color.Error),
        ProtocolStatus.CorrectionRequested => ("Correção", Icons.Material.Filled.Edit, Color.Warning),
        ProtocolStatus.Finalized => ("Finalizado", Icons.Material.Filled.DoneAll, Color.Dark),
        _ => ("Desconhecido", Icons.Material.Filled.HelpOutline, Color.Default)
    };

    protected override void OnInitialized() =>
    _selectedUsers.Clear();

    /// <summary>
    /// Loads paginated sector data from the server for MudTable component.
    /// </summary>
    /// <param name="state">The table state (page, sorting, etc).</param>
    /// <param name="cancellationToken">Cancellation token.</param>
    /// <returns>TableData with users and total count.</returns>
    private async Task<TableData<UserListItemDTO>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        isLoading = true;
        StateHasChanged();

        pageSize = state.PageSize;
        string? sortLabel = state.SortLabel;

        if (string.IsNullOrWhiteSpace(sortLabel))
            sortLabel = "Status";

        try
        {
            PagedResultDTO<UserListItemDTO>? users = await _userService.GetPagedAsync(
                state.Page + 1,
                state.PageSize,
                sortLabel,
                GetSortDirectionString(state.SortDirection),
                searchString);

            return new TableData<UserListItemDTO>
            {
                Items = users!.Items,
                TotalItems = users.TotalCount
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar dados: {ex.Message}", Severity.Error);
            return new TableData<UserListItemDTO> { Items = [], TotalItems = 0 };
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Toggles the visibility of related protocols for a user.
    /// </summary>
    /// <param name="user">The sector to toggle.</param>
    private async Task ToggleShowProtocols(UserListItemDTO user)
    {
        if (openUserIds.Contains(user.Id))
        {
            openUserIds.Remove(user.Id);
            userProtocols.Remove(user.Id);
        }
        else
        {
            // collapse all others
            foreach (var id in openUserIds.ToList())
            {
                openUserIds.Remove(id);
                userProtocols.Remove(id);
            }
            // open this one
            openUserIds.Add(user.Id);
            if (!userProtocols.ContainsKey(user.Id))
                userProtocols[user.Id] = await _userService.GetCreatedProtocolsByUserAsync(user.Id);
        }
        StateHasChanged();
    }

    private Task OnSelectedItemsChanged(HashSet<UserListItemDTO> selected)
    {
        // new selection ids (snapshot of the passed set)
        var newIds = new HashSet<Guid>(selected.Select(s => s.Id));

        // removed ids = previously selected but not in new selection
        var removedIds = _previousSelectedIds.Except(newIds).ToList();
        foreach (var id in removedIds)
        {
            if (openUserIds.Contains(id))
            {
                openUserIds.Remove(id);
                userProtocols.Remove(id);
            }
        }

        // added ids = newly selected
        var addedIds = newIds.Except(_previousSelectedIds).ToList();
        if (addedIds.Any())
        {
            // keep only last-added open: collapse others
            var lastAddedId = addedIds.Last();
            foreach (var id in openUserIds.ToList())
            {
                if (id != lastAddedId)
                {
                    openUserIds.Remove(id);
                    userProtocols.Remove(id);
                }
            }
        }

        // update your selection references
        _selectedUsers = selected;
        _previousSelectedIds = newIds;

        // if selection became empty, ensure all child rows closed
        if (!newIds.Any())
        {
            openUserIds.Clear();
            userProtocols.Clear();
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private string GetSortDirectionString(SortDirection direction) =>
        direction switch
        {
            SortDirection.Ascending => "asc",
            SortDirection.Descending => "desc",
            _ => string.Empty
        };

    private async Task OnSearch(string value)
    {
        searchString = value;
        if (table is not null)
            await table.ReloadServerData();
    }

    @* ------- Comportamento dos Diálogos ------- *@

    private async Task ShowAddDialog()
    {
        _isModalOpen = true;

        DialogParameters<UserAddDialog> parameters = new();
        parameters.Add(x => x.User, new UserCreateDTO());
        IDialogReference dialog = await DialogService.ShowAsync<UserAddDialog>("", parameters);
        DialogResult? result = await dialog.Result;

        _isModalOpen = false;

        if (result is not null && !result.Canceled)
        {
            UserCreateDTO? savedUser = result.Data as UserCreateDTO;

            if (savedUser != null)
            {
                try
                {
                    await _userService.CreateAsync(savedUser);
                    Snackbar.Add("Usuário criado com sucesso!", Severity.Success);
                    if (table is not null)
                        await table.ReloadServerData();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao criar usuário: {ex.Message}", Severity.Error);
                }
            }
        }
        else
        {
            Snackbar.Add("Inserção de usuário cancelada.", Severity.Info);
        }
    }

    private async Task ShowEditBasicDialog(UserListItemDTO userToEdit)
    {
        PagedResultDTO<UserListItemDTO>? detailed = await _userService.GetDetailsAsync(userToEdit.Id);

        var fullUser = detailed?.Items?.FirstOrDefault();

        if (fullUser == null)
        {
            Snackbar.Add("Não foi possível carregar os dados completos do usuário.", Severity.Error);
            return;
        }

        DialogParameters<UserEditDialog> parameters = new();

        parameters.Add(x => x.User, new UserUpdateDTO
        {
            Id = fullUser.Id,
            Name = fullUser.Name!,
            Login = fullUser.Login!,
            Masp = fullUser.Masp,
            Email = fullUser.Email!,
            Role = fullUser.Role,
            Status = fullUser.Status
        });

        IDialogReference dialog = await DialogService.ShowAsync<UserEditDialog>("", parameters);

        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            UserUpdateDTO? updatedUser = result.Data as UserUpdateDTO;

            if (updatedUser != null)
            {
                try
                {
                    await _userService.UpdateAsync(updatedUser);

                    Snackbar.Add("Usuário atualizado com sucesso!", Severity.Success);

                    if (table is not null)
                        await table.ReloadServerData();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao atualizar usuário: {ex.Message}", Severity.Error);
                }
            }
            else
            {
                Snackbar.Add("Erro: Não foi possível processar os dados retornados pelo formulário de edição.", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Edição de usuário cancelada.", Severity.Info);
        }
    }

    private async Task ShowChangePasswordDialog(UserListItemDTO user)
    {
        DialogParameters<UserChangePasswordDialog> parameters = new();

        parameters.Add(x => x.Users, new AdminResetPasswordDTO { Id = user.Id, Login = user.Login! });

        IDialogReference dialog = await DialogService.ShowAsync<UserChangePasswordDialog>("", parameters);
        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            User? updatedUser = result.Data as User;
            if (updatedUser != null)
            {
                try
                {
                    await _userService.DefaultChangePasswordAsync(updatedUser.Id, updatedUser.Password);
                    Snackbar.Add("Senha alterada com sucesso!", Severity.Success);
                    if (table is not null)
                        await table.ReloadServerData();
                }
                catch (Exception ex)
                {
                    Snackbar.Add($"Erro ao alterar senha: {ex.Message}", Severity.Error);
                }
            }
        }
        else
        {
            Snackbar.Add("Alteração de senha cancelada.", Severity.Info);
        }
    }

    private async Task ShowChangeSectorDialog(UserListItemDTO user)
    {
        PagedResultDTO<UserListItemDTO>? detailed = await _userService.GetDetailsAsync(user.Id);

        var fullUser = detailed?.Items?.FirstOrDefault();

        if (fullUser == null)
        {
            Snackbar.Add("Não foi possível carregar os dados completos do usuário.", Severity.Error);
            return;
        }

        DialogParameters<UserChangeSectorDialog> parameters = new();

        parameters.Add(x => x.Users, new User
        {
            Id = fullUser.Id,
            Login = fullUser.Login!,
            SectorId = fullUser.SectorId
        });
        if (user == null) return;

        _isModalOpen = true;

        var dialog = await DialogService.ShowAsync<UserChangeSectorDialog>(
            title: $" ",
            parameters: parameters,
            options: new DialogOptions { CloseButton = false, MaxWidth = MaxWidth.ExtraSmall }
        );

        var result = await dialog.Result;

        _isModalOpen = false;

        if (result is not null && !result.Canceled)
        {
            // O diálogo retorna o usuário atualizado
            var updatedUser = result.Data as User;
            if (updatedUser != null)
            {
                Snackbar.Add($"Setor redefinido com sucesso para o usuário '{updatedUser.Login}' !", Severity.Success);

                // Recarrega a tabela de usuários
                if (table != null)
                    await table.ReloadServerData();
            }
        }
        else
        {
            Snackbar.Add("Alteração de setor cancelada.", Severity.Info);
        }
    }

    private async Task ShowDeleteDialog(UserListItemDTO user)
    {
        DialogParameters<UserDeleteDialog> parameters = new();

        parameters.Add(x => x.UserToDelete, user);

        IDialogReference dialog = await DialogService.ShowAsync<UserDeleteDialog>("", parameters);

        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            try
            {
                await _userService.DeleteAsync(user.Id);
                Snackbar.Add("Usuário excluído com sucesso!", Severity.Success);
                if (table is not null)
                    await table.ReloadServerData();
            }
            catch (InvalidOperationException ex)
            {
                Snackbar.Add($"Erro ao excluir usuário: {ex.Message}", Severity.Error);
            }
            catch (HttpRequestException ex)
            {
                Snackbar.Add($"Erro de comunicação: {ex.Message}", Severity.Error);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Ocorreu um erro inesperado: {ex.Message}", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Exclusão de usuário cancelada.", Severity.Info);
        }

    }

