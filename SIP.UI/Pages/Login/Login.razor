@using System.ComponentModel.DataAnnotations

@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]

@inject SIP.UI.Domain.Interfaces.Auth.IAuthService AuthService
@inject NavigationManager Navigation
@inject MudBlazor.ISnackbar Snackbar

<div class="login-page-card">
    <MudPaper Class="login-card-paper" Elevation="0">

        <!-- HEADER -->
        <div class="login-card-header">
            <MudText Class="login-card-title" Align="Align.Center">
                SIP Login
            </MudText>

            <MudText Class="login-card-subtitle" Align="Align.Center">
                Faça login com suas credenciais corporativas.
            </MudText>
        </div>

        <!-- FORM -->
        <EditForm Model="_loginModel" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="login-form-container">

                <!-- LOGIN -->
                <MudTextField 
                    T="string" 
                    Label="Login do usuário" 
                    @bind-Value="_loginModel.Login"
                    For="() => _loginModel.Login" 
                    Variant="Variant.Filled" 
                    FullWidth="true" 
                    Immediate="false"
                    Margin="Margin.Dense" 
                    Class="login-card-input" />

                <!-- SENHA -->
                <MudTextField 
                    T="string" 
                    Label="Senha" 
                    @bind-Value="_loginModel.Password" 
                    For="() => _loginModel.Password" 
                    InputType="@(_showPassword? InputType.Text: InputType.Password)" 
                    Variant="Variant.Filled" 
                    FullWidth="true" 
                    Immediate="false" 
                    Margin="Margin.Dense" 
                    Adornment="Adornment.End" 
                    AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)" 
                    OnAdornmentClick="TogglePasswordVisibility" Class="login-card-input" />

                <!-- BUTTON -->
                <MudButton 
                    Variant="Variant.Filled" 
                    Color="Color.Primary" 
                    ButtonType="ButtonType.Submit" 
                    Disabled="_isSubmitting" 
                    FullWidth 
                    Class="login-card-button">

                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Indeterminate Size="Size.Small" Class="mr-2" />
                        <span>Entrando...</span>
                    }
                    else
                    {
                        <span>Entrar</span>
                    }
                </MudButton>

                <!-- INFO -->
                <MudText Class="login-extra-text">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="mr-1" />
                    <span>Mantemos seu acesso seguro.</span>
                </MudText>

            </div>
        </EditForm>

    </MudPaper>
</div>

@code {
    private bool _isSubmitting;
    private bool _showPassword;

    private LoginModel _loginModel = new();

    private async Task HandleSubmit()
    {
        _isSubmitting = true;

        try
        {
            var success = await AuthService.LoginAsync(_loginModel.Login, _loginModel.Password);

            if (success)
            {
                Snackbar.Add("Login efetuado com sucesso.", Severity.Success);
                Navigation.NavigateTo("/");
            }
            else
            {
                Snackbar.Add("Credenciais de acesso inválidas!", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao efetuar login: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Login é obrigatório.")]
        public string Login { get; set; } = string.Empty;

        [Required(ErrorMessage = "Senha é obrigatória.")]
        public string Password { get; set; } = string.Empty;
    }
}