@using System.ComponentModel.DataAnnotations
@using SIP.UI.Domain.Enums

@page "/login"

@layout LoginLayout

@attribute [AllowAnonymous]

@implements IDisposable

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div class="">

    <MudPaper Class="login-card-paper" Elevation="0">

        <!-- HEADER -->
        <div class="login-card-header">
            <div class="login-card-logo" role="img" aria-label="Placeholder para imagem">
                <img src="/images/logo.png" alt="Alternate Text" />
            </div>

            <MudText Class="login-card-main-title" Align="Align.Center">SIP</MudText>
            <MudText Class="login-card-main-subtitle" Align="Align.Center">SISTEMA INTERNO DE PROTOCOLO</MudText>

            <div class="login-card-divider"></div>

            <MudText Class="login-card-subtitle" Align="Align.Center">Faça login com suas credenciais corporativas.</MudText>
        </div>

        <!-- FORM -->
        <EditForm Model="_loginModel" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="login-form-container">

                <!-- LOGIN -->
                <div class="input-with-left-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="left-input-icon" Size="Size.Small" />
                    <MudTextField T="string"
                                  Label="Login do usuário"
                                  @bind-Value="_loginModel.Login"
                                  For="() => _loginModel.Login"
                                  Variant="Variant.Filled"
                                  FullWidth="true"
                                  Immediate="false"
                                  Margin="Margin.Dense"
                                  Class="@($"login-card-input with-left-icon {(!string.IsNullOrWhiteSpace(_loginModel.Login) ? "is-filled" : "")}")" />
                </div>

                <!-- SENHA -->
                <div class="input-with-left-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Class="left-input-icon" Size="Size.Small" />
                    <MudTextField T="string"
                                  Label="Senha"
                                  @bind-Value="_loginModel.Password"
                                  For="() => _loginModel.Password"
                                  InputType="@(_showPassword? InputType.Text: InputType.Password)"
                                  Variant="Variant.Filled"
                                  FullWidth="true"
                                  Immediate="false"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="TogglePasswordVisibility" Class="@($"login-card-input with-left-icon {(!string.IsNullOrWhiteSpace(_loginModel.Password) ? "is-filled" : "")}")" />
                </div>

                <!-- BUTTON -->
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           Disabled="@(_isSubmitting || _isBlocked)"
                           FullWidth
                           Class="login-card-button">

                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Indeterminate Size="Size.Small" Class="mr-2" />
                        <span>Entrando...</span>
                    }
                    else if (_isBlocked)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Block" Class="mr-2" />
                        <span>Bloqueado (@_blockCountdown s)</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.LockOpen" Class="mr-2" />
                        <span>Entrar</span>
                    }
                </MudButton>

                <!-- INFO -->
                <MudText Class="login-extra-text">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="mr-1" />
                    <span>Mantemos seu acesso seguro.</span>
                </MudText>

            </div>
        </EditForm>

    </MudPaper>
</div>

@code {
    private bool _isSubmitting;
    private bool _showPassword;
    private bool _isBlocked;
    private int _blockCountdown;
    private System.Threading.CancellationTokenSource? _blockCts;

    private LoginModel _loginModel = new();

    private async Task HandleSubmit()
    {
        _isSubmitting = true;

        LoginResult result = LoginResult.Error;

        try
        {
            result = await AuthService.LoginAsync(_loginModel.Login, _loginModel.Password);
        }
        catch
        {
            result = LoginResult.Error;
        }

        _isSubmitting = false;

        switch (result)
        {
            case LoginResult.Success:
                Snackbar.Add("Login efetuado com sucesso.", Severity.Success);
                Navigation.NavigateTo("/");
                break;

            case LoginResult.TooManyRequests:
                Snackbar.Add("Muitas tentativas de login. Aguarde antes de tentar novamente.", Severity.Warning);
                await StartBlockCountdownAsync(60);
                break;

            case LoginResult.InvalidCredentials:
                Snackbar.Add("Credenciais de acesso inválidas!", Severity.Error);
                break;

            default:
                Snackbar.Add("Não foi possível efetuar o login. Tente novamente.", Severity.Error);
                break;
        }
    }

    private async Task StartBlockCountdownAsync(int seconds)
    {
        _blockCts?.Cancel();
        _blockCts = new System.Threading.CancellationTokenSource();
        var token = _blockCts.Token;

        _isBlocked = true;
        _blockCountdown = seconds;
        StateHasChanged();

        try
        {
            while (_blockCountdown > 0 && !token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                _blockCountdown--;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        finally
        {
            _isBlocked = false;
            _blockCountdown = 0;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _blockCts?.Cancel();
        _blockCts?.Dispose();
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Login é obrigatório.")]
        public string Login { get; set; } = string.Empty;

        [Required(ErrorMessage = "Senha é obrigatória.")]
        public string Password { get; set; } = string.Empty;
    }
}