@using MudBlazor
@using MudBlazor.Services
@inject SIP.UI.Domain.Interfaces.Auth.IAuthService AuthService

<MudDialog>
    <DialogContent>
        <MudPaper Class="pa-4" Elevation="0" Style="background:transparent;">
            <div class="d-flex align-center">
                <MudAvatar Color="Color.Warning" Size="Size.Medium" Class="mr-3">
                    <MudIcon Class="margin:auto" Icon="@Icons.Material.Filled.Warning" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h6">Sessão quase expirada</MudText>
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Por motivos de segurança sua sessão será encerrada em breve.</MudText>
                </div>
            </div>

            <div class="mt-4">
                <MudText Typo="Typo.h3" Align="Align.Center">@SecondsRemainingString</MudText>
                <MudProgressLinear Color="Color.Error" Value="@ProgressPercent" Class="mt-2" />
            </div>

            <div class="d-flex justify-end mt-4">
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="LogoutNow">Encerrar sessão</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ContinueSession" Class="ml-2">Continuar sessão</MudButton>
            </div>
        </MudPaper>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int InitialSeconds { get; set; } = 60;

    private int _secondsRemaining;
    private System.Timers.Timer? _timer;

    protected override void OnInitialized()
    {
        AuthService.SessionExpiring += UpdateSeconds;

        _secondsRemaining = InitialSeconds;

        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (s, e) =>
        {
            if (_secondsRemaining > 0)
            {
                _secondsRemaining--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                // no more time, ensure dialog closes
                try { MudDialog.Close(); } catch { }
            }
        };
        _timer.Start();
    }

    private void UpdateSeconds(int seconds)
    {
        _secondsRemaining = seconds;
        InvokeAsync(StateHasChanged);
    }

    private string SecondsRemainingString => _secondsRemaining > 0 ? $"{_secondsRemaining}s" : "—";

    private double ProgressPercent => InitialSeconds > 0 ? Math.Min(100.0, 100.0 * (InitialSeconds - _secondsRemaining) / InitialSeconds) : 100.0;

    private async Task ContinueSession()
    {
        await AuthService.KeepAliveAsync();
        _timer?.Stop();
        MudDialog.Close();
    }

    private async Task LogoutNow()
    {
        _timer?.Stop();
        try { await AuthService.LogoutAsync(); } catch { }
        MudDialog.Close();
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        AuthService.SessionExpiring -= UpdateSeconds;
    }
}
