@using MudBlazor

@inject IAuthService AuthService

@implements IDisposable

<MudDialog paperClass="session-warning-paper" maxWidth="MaxWidth.Small" disableBackdropClick="true" disableEscapeKey="true">
    <DialogContent>
        <div style="display:flex; gap:16px; align-items:center;">
            <MudProgressCircular diameter="56" thickness="6" Value="@ProgressPercent" Color="@GetProgressColor()" />
            <div style="display:flex; flex-direction:column;">
                <MudText Typo="Typo.h6" Class="session-warning-title">Sua sessão está prestes a expirar</MudText>
                <MudText Typo="Typo.body2" Class="session-warning-subtitle">Por motivos de segurança, a sessão será encerrada se não houver atividade.</MudText>
                <div style="margin-top:8px;">
                    <MudText Typo="Typo.subtitle2" Class="session-timer-countdown">Tempo restante: <b>@SecondsRemainingString</b>s</MudText>
                </div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="ContinueSession" Variant="Variant.Filled" Color="Color.Primary" Class="session-continue-btn">Manter sessão</MudButton>
        <MudButton OnClick="LogoutNow" Variant="Variant.Text" Color="Color.Error" Class="session-logout-btn">Sair</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int InitialSeconds { get; set; } = 10;

    private int _secondsRemaining;
    private System.Timers.Timer? _timer;
    private bool _isClosing;

    protected override void OnInitialized()
    {
        _secondsRemaining = InitialSeconds > 0 ? InitialSeconds : 10;

        _timer = new System.Timers.Timer(1000);
        _timer.AutoReset = true;
        _timer.Elapsed += async (_, _) =>
        {
            if (_secondsRemaining > 0)
            {
                _secondsRemaining--;
                await InvokeAsync(StateHasChanged);
                return;
            }

            CloseDialogOnly();
        };

        _timer.Start();
    }

    private string SecondsRemainingString => _secondsRemaining > 0 ? _secondsRemaining.ToString() : "0";

    private double ProgressPercent => InitialSeconds > 0
        ? 100.0 * _secondsRemaining / InitialSeconds
        : 0;

    private Color GetProgressColor()
    {
        if (_secondsRemaining <= 5) return Color.Error;
        if (_secondsRemaining <= 15) return Color.Warning;

        return Color.Primary;
    }

    private async Task ContinueSession()
    {
        if (_isClosing) return;

        _isClosing = true;
        DisposeTimer();

        await AuthService.KeepAliveAsync();

        CloseDialogOnly();
    }

    private async Task LogoutNow()
    {
        if (_isClosing) return;

        _isClosing = true;
        DisposeTimer();

        try
        {
            await AuthService.LogoutAsync();
        }
        catch
        {
            // Mantém comportamento atual: a falha de logout não quebra o diálogo.
        }

        CloseDialogOnly();
    }

    private void CloseDialogOnly()
    {
        try
        {
            DisposeTimer();
            MudDialog.Close();
        }
        catch { }
    }

    private void DisposeTimer()
    {
        if (_timer is null)
            return;

        _timer.Stop();
        _timer.Dispose();
        _timer = null;
    }

    public void Dispose()
    {
        DisposeTimer();
    }
}