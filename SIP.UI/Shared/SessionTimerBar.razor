@using MudBlazor

@inject IAuthService AuthService

@implements IDisposable

<div class="@TimerCssClass" role="status" aria-live="polite">
    <div class="session-timer-content">
        <div class="session-timer-icon-box">
            <MudIcon Icon="@TimerIcon" Size="Size.Small" />
        </div>

        <div class="session-timer-info">
            <span class="session-timer-title">Sessão</span>
            <span class="session-timer-status">@TimerStatusText</span>
        </div>

        <span class="session-timer-time">@_formattedTime</span>
    </div>

    <div class="session-timer-progress">
        <div class="session-timer-progress-fill" style="width:@ProgressPercentCss"></div>
    </div>
</div>

@code {
    private int _secondsRemaining = 0;
    private int _initialWarningSeconds = 10;
    private string _formattedTime = "0:00";
    private System.Timers.Timer? _timer;
    private bool _inWarningState = false;
    private bool _isRenewing = false;

    // Deve refletir o mesmo valor usado no start do idleTimer.js.
    // Se futuramente o backend enviar outro tempo, substitua por configuração compartilhada.
    private const int VisualSessionSeconds = 5 * 60;

    private string TimerStatusText
    {
        get
        {
            if (_inWarningState || _secondsRemaining <= 10)
                return "Expirando";

            if (ProgressPercent <= 30)
                return "Atenção";

            return "Ativa";
        }
    }

    private string TimerIcon
    {
        get
        {
            if (_inWarningState || _secondsRemaining <= 10)
                return Icons.Material.Filled.WarningAmber;

            if (ProgressPercent <= 30)
                return Icons.Material.Filled.Schedule;

            return Icons.Material.Filled.VerifiedUser;
        }
    }

    private string TimerCssClass
    {
        get
        {
            if (_inWarningState || _secondsRemaining <= 10)
                return "session-timer-card session-timer-critical";

            if (ProgressPercent <= 30)
                return "session-timer-card session-timer-warning";

            return "session-timer-card session-timer-active";
        }
    }

    protected override void OnInitialized()
    {
        AuthService.SessionExpiring += OnSessionExpiring;
        AuthService.SessionRenewed += OnSessionRenewed;
        AuthService.SessionAutoRenewed += OnAutoRenewed;
        AuthService.UserActivityDetected += OnUserActivityDetected;

        ResetToActiveState();
    }

    private void OnSessionExpiring(int seconds)
    {
        _inWarningState = true;
        _initialWarningSeconds = seconds > 0 ? seconds : _initialWarningSeconds;
        _secondsRemaining = _initialWarningSeconds;
        _formattedTime = FormatTime(_secondsRemaining);

        StartLocalTimer();
        InvokeAsync(StateHasChanged);
    }

    private void OnSessionRenewed()
    {
        ResetToActiveState();
        InvokeAsync(StateHasChanged);
    }

    private void OnAutoRenewed()
    {
        ResetToActiveState();
        InvokeAsync(StateHasChanged);
    }

    private void ResetToActiveState()
    {
        _inWarningState = false;
        _isRenewing = false;
        _secondsRemaining = VisualSessionSeconds;
        _formattedTime = FormatTime(_secondsRemaining);

        StartLocalTimer();
    }

    private void StartLocalTimer()
    {
        DisposeTimer();

        _timer = new System.Timers.Timer(1000);
        _timer.AutoReset = true;
        _timer.Elapsed += async (_, _) =>
        {
            if (_secondsRemaining > 0)
            {
                _secondsRemaining--;
                _formattedTime = FormatTime(_secondsRemaining);
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (_formattedTime != "0:00")
            {
                _formattedTime = "0:00";
                await InvokeAsync(StateHasChanged);
            }
        };

        _timer.Start();
    }

    private void DisposeTimer()
    {
        if (_timer is null)
            return;

        _timer.Stop();
        _timer.Dispose();
        _timer = null;
    }

    private static string FormatTime(int seconds)
    {
        if (seconds <= 0) return "0:00";

        int minutes = seconds / 60;
        int secs = seconds % 60;

        return $"{minutes}:{secs:D2}";
    }

    private double ProgressPercent
    {
        get
        {
            var denom = _inWarningState ? _initialWarningSeconds : VisualSessionSeconds;
            return denom <= 0 ? 0 : 100.0 * _secondsRemaining / denom;
        }
    }

    // Garante formatação invariante (ponto decimal) e clamp entre 0 e 100 para uso em CSS inline
    private string ProgressPercentCss
    {
        get
        {
            var pct = ProgressPercent;
            if (double.IsNaN(pct) || double.IsInfinity(pct)) pct = 0;
            if (pct < 0) pct = 0;
            if (pct > 100) pct = 100;

            // Usa '.' como separador decimal independentemente da cultura
            return string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:0.##}%", pct);
        }
    }

    private Color GetProgressColor()
    {
        var denom = _inWarningState ? _initialWarningSeconds : VisualSessionSeconds;

        if (denom <= 0) return Color.Default;

        var pct = (double)_secondsRemaining / denom;

        if (pct <= 0.33) return Color.Error;
        if (pct <= 0.66) return Color.Warning;

        return Color.Success;
    }

    private void OnUserActivityDetected()
    {
        InvokeAsync(async () =>
        {
            // Não reinicia o contador visual a cada interação.
            // A renovação deve acontecer somente quando:
            // - o JS chegar ao fim do ciclo e chamar OnActivityRenewal; ou
            // - o usuário estiver no warning/zerado e interagir de forma explícita.
            if ((_inWarningState || _secondsRemaining <= 0) && !_isRenewing)
            {
                _isRenewing = true;

                try
                {
                    await AuthService.KeepAliveAsync();
                }
                catch
                {
                    // KeepAliveAsync deve tratar falhas/logoff conforme implementação atual.
                }
                finally
                {
                    _isRenewing = false;
                }
            }

            await InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        AuthService.SessionExpiring -= OnSessionExpiring;
        AuthService.SessionRenewed -= OnSessionRenewed;
        AuthService.SessionAutoRenewed -= OnAutoRenewed;
        AuthService.UserActivityDetected -= OnUserActivityDetected;

        DisposeTimer();
    }
}