@using MudBlazor

@inject SIP.UI.Domain.Interfaces.Auth.IAuthService AuthService
@inject IDialogService DialogService

@implements IDisposable

@code {

    private IDialogReference? _dialogRef;

    protected override void OnInitialized()
    {
        AuthService.SessionExpiring += OnSessionExpiring;
    }

    private async void OnSessionExpiring(int seconds)
    {
        // If dialog already open, do nothing (dialog subscribes to updates).
        if (_dialogRef != null)
            return;

        var options = new DialogOptions
        {
            CloseButton = false,
            MaxWidth = MaxWidth.Small
        };
        var parameters = new DialogParameters { ["InitialSeconds"] = seconds };
        _dialogRef = await DialogService.ShowAsync<SessionWarningDialog>("Sua sessão está prestes a expirar", parameters, options);

        // When dialog closes, clear reference
        _ = _dialogRef.Result.ContinueWith(t => _dialogRef = null);
    }

    public void Dispose()
    {
        AuthService.SessionExpiring -= OnSessionExpiring;
    }

}
