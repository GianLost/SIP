@using MudBlazor

@inject IAuthService AuthService
@inject IDialogService DialogService

@implements IDisposable

@code {
    private IDialogReference? _dialogRef;

    protected override void OnInitialized()
    {
        AuthService.SessionExpiring += OnSessionExpiring;
    }

    private async void OnSessionExpiring(int seconds)
    {
        if (_dialogRef is not null)
            return;

        var parameters = new DialogParameters
        {
            ["InitialSeconds"] = seconds
        };

        var options = new DialogOptions
        {
            CloseButton = false,
            BackdropClick = false,
            CloseOnEscapeKey = false,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        _dialogRef = await DialogService.ShowAsync<SessionWarningDialog>(
            "Sua sessão está prestes a expirar",
            parameters,
            options
        );

        _ = _dialogRef.Result.ContinueWith(_ =>
        {
            _dialogRef = null;
        });
    }

    public void Dispose()
    {
        AuthService.SessionExpiring -= OnSessionExpiring;
    }
}