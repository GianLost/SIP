@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inherits LayoutComponentBase

@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SIP.UI.Domain.Interfaces.Auth.IAuthService AuthService

<MudThemeProvider @ref="_mudThemeProvider" IsDarkMode="@_isDarkMode" Theme="@(_isDarkMode? DarkTheme : LightTheme)" />

<MudDialogProvider />
<SessionTimeout />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Class="mud-height-full">

    <!-- APPBAR -->
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />

        <MudText Typo="Typo.h6" Class="ml-4">
            SIP - SISTEMA INTERNO DE PROTOCOLO
        </MudText>

        <MudSpacer />

        <div class="session-timer">
            <SessionTimerBar />
        </div>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.subtitle2" Class="mr-3">
                    @context.User.Identity?.Name
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" />
            </Authorized>
            @* <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(async () => Navigation.NavigateTo("/login"))">
                    Entrar
                </MudButton>
            </NotAuthorized> *@
        </AuthorizeView>
    </MudAppBar>

    <!-- CONTAINER -->
    <MudDrawerContainer Class="mud-height-full">

        <!-- DRAWER MINI -->
        <MudDrawer @bind-Open="_isDrawerOpen" 
                   Color="Color.Inherit"
                   Variant="DrawerVariant.Mini"
                   OpenMiniOnHover="true"
                   Fixed="true"
                   ClipMode="DrawerClipMode.Never"
                   Elevation="2"
                   Breakpoint="Breakpoint.None">

            <MudDrawerHeader>
                @if (_isDrawerOpen)
                {
                    <MudText Typo="Typo.subtitle1">Menu</MudText>
                }
            </MudDrawerHeader>

            <AuthorizeView>
                <Authorized>
                    <MudNavMenu Class="full-width-nav" Bordered="true" Color="Color.Primary">

                        <MudNavLink Class="mt-1" Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">
                            Início
                        </MudNavLink>

                        <MudDivider Light="true" Class="my-1" />

                        <MudNavLink Href="/sectors" Icon="@Icons.Material.Filled.Business">
                            Secretarias
                        </MudNavLink>

                        <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">
                            Usuários
                        </MudNavLink>

                        <MudNavLink Href="/protocols" Icon="@Icons.Material.Filled.Book">
                            Protocolos
                        </MudNavLink>

                        <MudDivider Light="true" Class="my-1" />

                        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
                            Configurações
                        </MudNavLink>

                        <MudNavLink Href="/help" Icon="@Icons.Material.Filled.Help">
                            Ajuda
                        </MudNavLink>

                    </MudNavMenu>
                </Authorized>

            </AuthorizeView>

            <MudSpacer  />

            <MudContainer Class="m-auto p-1">
                <MudIconButton Icon="@Icons.Material.Filled.Brightness4"
                               OnClick="ToggleTheme"
                               Class="mb-2 toggle-theme"
                               Color="Color.Inherit" />
            </MudContainer>

        </MudDrawer>

        <!-- CONTEÚDO -->
        <MudMainContent Class="main-content">
            @Body
        </MudMainContent>

    </MudDrawerContainer>

</MudLayout>

@code {

    private bool _isDrawerOpen = false;
    private bool _isDarkMode = true;

    private MudThemeProvider? _mudThemeProvider;

    private readonly MudTheme LightTheme = new()
    {
        PaletteLight = new()
        {
            Primary = Colors.Blue.Default,
            AppbarBackground = Colors.Blue.Default,
            AppbarText = "#ffffff",
            Background = "#f5f5f5"
        }
    };

    private readonly MudTheme DarkTheme = new()
    {
        PaletteDark = new()
        {
            Primary = Colors.Cyan.Darken2,
            AppbarBackground = Colors.Cyan.Darken2,
            AppbarText = "#ffffff",
            Background = "#27272f"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var theme = await JS.InvokeAsync<string>("localStorage.getItem", "sip-theme");

        if (!string.IsNullOrEmpty(theme))
            _isDarkMode = theme == "dark";
        else if (_mudThemeProvider is not null)
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
    }

    private void ToggleDrawer() => _isDrawerOpen = !_isDrawerOpen;

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "sip-theme", _isDarkMode ? "dark" : "light");
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}