@using MudBlazor
@using Microsoft.JSInterop

@inherits LayoutComponentBase

@inject IJSRuntime JS

<!-- Provedor global de tema utilizado na tela de login -->
<MudThemeProvider @ref="_mudThemeProvider"
                  IsDarkMode="_isDarkMode"
                  Theme="@(_isDarkMode ? DarkTheme : LightTheme)" />

<!-- Provedores globais necessários para os componentes MudBlazor -->
<MudSnackbarProvider />
<MudDialogProvider />
<MudPopoverProvider />

<!-- Estrutura visual exclusiva das páginas de autenticação -->
<div class="login-layout-wrapper">

    <!-- Área central onde o conteúdo da página de login será renderizado -->
    <div class="login-layout-content">
        @Body
    </div>

</div>

@code {

    // Controla se o layout de login está utilizando o tema escuro.
    private bool _isDarkMode = true;

    // Referência ao provedor de tema do MudBlazor.
    private MudThemeProvider? _mudThemeProvider;

    // Configuração visual aplicada quando o tema claro estiver ativo.
    private readonly MudTheme LightTheme = new()
    {
        PaletteLight = new()
        {
            Primary = Colors.Blue.Default,
            PrimaryContrastText = "#ffffff",

            AppbarBackground = Colors.Blue.Default,
            AppbarText = "#ffffff",
            Background = "#f5f5f5",

            ActionDisabled = "#ffffff",
            ActionDisabledBackground = Colors.Blue.Default
        }
    };

    // Configuração visual aplicada quando o tema escuro estiver ativo.
    private readonly MudTheme DarkTheme = new()
    {
        PaletteDark = new()
        {
            Primary = Colors.Cyan.Darken2,
            PrimaryContrastText = "#ffffff",

            AppbarBackground = Colors.Cyan.Darken2,
            AppbarText = "#ffffff",
            Background = "#27272f",

            ActionDisabled = "#ffffff",
            ActionDisabledBackground = Colors.Cyan.Darken2
        }
    };

    // Após a primeira renderização, recupera a preferência de tema salva no navegador.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var theme = await JS.InvokeAsync<string>("localStorage.getItem", "sip-theme");

        if (!string.IsNullOrEmpty(theme))
            _isDarkMode = theme == "dark";
        else if (_mudThemeProvider is not null)
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();

        StateHasChanged();
    }
}