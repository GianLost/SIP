@using MudBlazor
@using Microsoft.JSInterop
@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider @ref="_mudThemeProvider" IsDarkMode="_isDarkMode" Theme="@(_isDarkMode? DarkTheme : LightTheme)" />

<MudSnackbarProvider />
<MudDialogProvider />
<MudPopoverProvider />

<div class="login-layout-wrapper">
    <div class="login-layout-content">
        @Body
    </div>
</div>

@code {
    private bool _isDarkMode = true;
    private MudThemeProvider? _mudThemeProvider;

    private readonly MudTheme LightTheme = new()
    {
        PaletteLight = new()
        {
            Primary = Colors.Blue.Default,
            PrimaryContrastText = "#ffffff",

            AppbarBackground = Colors.Blue.Default,
            AppbarText = "#ffffff",
            Background = "#f5f5f5",

            ActionDisabled = "#ffffff",
            ActionDisabledBackground = Colors.Blue.Default
        }
    };

    private readonly MudTheme DarkTheme = new()
    {
        PaletteDark = new()
        {
            Primary = Colors.Cyan.Darken2,
            PrimaryContrastText = "#ffffff",

            AppbarBackground = Colors.Cyan.Darken2,
            AppbarText = "#ffffff",
            Background = "#27272f",

            ActionDisabled = "#ffffff",
            ActionDisabledBackground = Colors.Cyan.Darken2
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var theme = await JS.InvokeAsync<string>("localStorage.getItem", "sip-theme");

        if (!string.IsNullOrEmpty(theme))
            _isDarkMode = theme == "dark";
        else if (_mudThemeProvider is not null)
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();

        StateHasChanged();
    }
}