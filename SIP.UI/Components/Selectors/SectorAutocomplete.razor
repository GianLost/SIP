@using SIP.UI.Domain.DTOs.Default.Pagination
@using SIP.UI.Domain.DTOs.Sectors.Pagination
@using SIP.UI.Domain.Services.Sectors
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using System.Threading
@using System.Linq
@using System.Collections.Concurrent

@implements IDisposable

@inject SectorService SectorService

@* Componente seletor *@
<MudTextField @bind-Value="searchTerm"
              Label="Setor*"
              Variant="Variant.Outlined"
              Adornment="Adornment.End"
              AdornmentIcon="@(showList? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)"
              AdornmentColor="Color.Inherit"
              @onclick="TogglePopover"
              Clearable="true"
              OnClearButtonClick="ClearSelection"
              ReadOnly="false"
              Immediate="true"
              @onkeyup="@((e) => OnSearchTermInput(e))"
              Placeholder="Selecione o setor"
              HelperText="Vincule o usuário à um setor."/>

@* Componente de renderização da lita suspensa virtualizada *@
<MudPopover Open="showList"
            AnchorOrigin="Origin.TopRight"
            TransformOrigin="Origin.TopLeft"
            RelativeWidth="DropdownWidth.Adaptive"
            Fixed="true"
            Class="sector-autocomplete-popover">

    <div class="sector-autocomplete-scroll-container" role="listbox">

        @* Virtualização dos registros para obtenção dinâmica e performática de registros com base na rolagem da lista *@
        <Virtualize TItem="SectorBasicListDTO"
                    ItemsProvider="LoadSectorsVirtualizedAsync"
                    OverscanCount="2"
                    @key="virtualizeKey">

            <ItemContent Context="sector">
                <div class="sector-option mud-ripple" @onclick="(() => SelectItem(sector))">
                    @sector.Acronym - @sector.Name
                </div>
            </ItemContent>
        </Virtualize>

        @* Mensagens informativas exibidas em caso de erro na busca de registros *@
        @if (!isLoadingItems && loadError)
        {
            <div class="pa-4 text-center mud-text-secondary">Erro ao carregar os registros. Tente novamente.</div>
        }
        else if (!isLoadingItems && noItems)
        {
            var term = string.IsNullOrWhiteSpace(searchTerm) ? "" : $" \"{searchTerm}\"";
            <div class="pa-4 text-center mud-text-secondary">Nenhum registro encontrado @term.</div>
        }
    </div>
</MudPopover>

@code {
    private string? searchTerm;
    private string? previousSearch = string.Empty;
    private bool showList = false;
    private SectorBasicListDTO? lastSelectedValue;
    private Guid virtualizeKey = Guid.NewGuid();
    private CancellationTokenSource? debounceCts;
    private readonly int debounceDelay = 300; // Tempo de espera(em milissegundos) antes de disparar a busca.

    /// <summary>
    /// Cache concorrente indexado por posição absoluta dos itens,
    /// utilizado para reduzir chamadas ao backend.
    /// </summary>
    private readonly ConcurrentDictionary<int, SectorBasicListDTO> indexCache = new();

    /// <summary>
    /// Quantidade total de registros disponíveis no backend.
    /// </summary>
    private int totalItemCount = 0;

    /// <summary>
    /// Indica se os itens estão sendo carregados no momento.
    /// </summary>
    private bool isLoadingItems;

    /// <summary>
    /// Indica se ocorreu erro durante a obtenção dos dados.
    /// </summary>
    private bool loadError;

    /// <summary>
    /// Indica se nenhuma informação foi encontrada para o termo atual.
    /// </summary>
    private bool noItems;

    /// <summary>
    /// Quantidade de registros retornados por página pela API.
    /// Deve estar alinhado com o backend.
    /// </summary>
    private readonly int ApiPageSize = 15;

    /// <summary>
    /// Quantidade máxima de páginas mantidas simultaneamente no cache.
    /// </summary>
    private readonly int MaxCachedPages = 5;

    /// <summary>
    /// Semáforo utilizado para evitar múltiplas requisições simultâneas.
    /// </summary>
    private readonly SemaphoreSlim fetchLock = new(1, 1);

    /// <summary>
    /// Token de cancelamento utilizado para abortar buscas em andamento
    /// quando o termo de pesquisa é alterado.
    /// </summary>
    private CancellationTokenSource? fetchCts;

    /// <summary>
    /// Valor atualmente selecionado no componente.
    /// </summary>
    [Parameter]
    public SectorBasicListDTO? Value { get; set; }

    /// <summary>
    /// Evento disparado quando o valor selecionado é alterado.
    /// </summary>
    [Parameter]
    public EventCallback<SectorBasicListDTO?> ValueChanged { get; set; }

    /// <summary>
    /// Libera todos os recursos utilizados pelo componente,
    /// incluindo tokens de cancelamento e semáforos.
    /// </summary>
    public void Dispose()
    {
        debounceCts?.Dispose();
        fetchCts?.Cancel();
        fetchCts?.Dispose();
        fetchLock.Dispose();
    }

    /// <summary>
    /// Sincroniza o estado interno do componente quando o parâmetro
    /// <see cref="Value"/> é alterado externamente.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (Value != null && Value != lastSelectedValue)
        {
            searchTerm = $"{Value.Name}";
            lastSelectedValue = Value;
        }
        else if (Value == null && lastSelectedValue != null)
        {
            searchTerm = null;
            lastSelectedValue = null;
        }
    }

    /// <summary>
    /// Alterna a visibilidade da lista suspensa (popover).
    /// Reinicia o cache e os indicadores de estado ao abrir.
    /// </summary>
    private void TogglePopover()
    {
        showList = !showList;

        if (showList)
        {
            indexCache.Clear();
            virtualizeKey = Guid.NewGuid();

            loadError = false;
            noItems = false;
        }
    }

    /// <summary>
    /// Define o setor selecionado, atualiza o valor exibido
    /// e notifica o componente pai.
    /// </summary>
    /// <param name="selectedSector">Setor selecionado pelo usuário.</param>
    private void SelectItem(SectorBasicListDTO selectedSector)
    {
        searchTerm = $"{selectedSector.Acronym} - {selectedSector.Name}";
        showList = false;
        lastSelectedValue = selectedSector;
        ValueChanged.InvokeAsync(selectedSector);
    }

    /// <summary>
    /// Limpa a seleção atual e reinicia o estado interno do componente.
    /// </summary>
    private void ClearSelection()
    {
        searchTerm = null;
        lastSelectedValue = null;
        ValueChanged.InvokeAsync(null);
        showList = false;
        indexCache.Clear();
        totalItemCount = 0;
        virtualizeKey = Guid.NewGuid();
        StateHasChanged();
    }

    /// <summary>
    /// Manipula a digitação do usuário aplicando debounce
    /// para evitar chamadas excessivas à API.
    /// </summary>
    /// <param name="e">Evento de teclado disparado pelo input.</param>
    private async Task OnSearchTermInput(KeyboardEventArgs e)
    {
        showList = true;
        debounceCts?.Cancel();
        debounceCts?.Dispose();

        debounceCts = new CancellationTokenSource();
        var token = debounceCts.Token;

        try
        {
            await Task.Delay(debounceDelay, token);

            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(() =>
                {
                    fetchCts?.Cancel();
                    fetchCts?.Dispose();
                    fetchCts = null;

                    indexCache.Clear();
                    totalItemCount = 0;
                    previousSearch = searchTerm?.Trim();

                    virtualizeKey = Guid.NewGuid();
                    StateHasChanged();
                });
            }
        }
        catch (TaskCanceledException)
        {
            // expected when typing quickly
        }
    }

    /// <summary>
    /// Provedor de dados utilizado pelo componente <see cref="Virtualize"/> para
    /// carregamento incremental (lazy loading) de setores de forma virtualizada,
    /// performática e segura.
    /// </summary>
    /// <param name="request">
    /// Objeto fornecido pelo Blazor contendo:
    /// <list type="bullet">
    /// <item>
    /// <description><see cref="ItemsProviderRequest.StartIndex"/> – índice absoluto inicial solicitado.</description>
    /// </item>
    /// <item>
    /// <description><see cref="ItemsProviderRequest.Count"/> – quantidade de itens esperados a partir do índice.</description>
    /// </item>
    /// </list>
    /// Esses valores variam conforme a rolagem da lista virtualizada.
    /// </param>
    /// <returns>
    /// Um <see cref="ItemsProviderResult{TItem}"/> contendo:
    /// <list type="bullet">
    /// <item>
    /// <description>Os itens disponíveis no intervalo solicitado.</description>
    /// </item>
    /// <item>
    /// <description>O total de registros existentes no backend, necessário para o correto funcionamento da virtualização.</description>
    /// </item>
    /// </list>
    /// </returns>
    /// <remarks>
    /// <para>
    /// Este método foi projetado para lidar com grandes volumes de dados,
    /// evitando carregamento completo da base e reduzindo chamadas desnecessárias à API.
    /// </para>
    ///
    /// <para>
    /// <b>Principais responsabilidades:</b>
    /// <list type="number">
    /// <item>
    /// <description>
    /// Detectar mudanças no termo de busca e invalidar cache quando necessário.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Reutilizar dados já carregados através de um cache indexado por posição absoluta.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Alinhar requisições ao backend em páginas fixas (<c>ApiPageSize</c>),
    /// mesmo que o Blazor solicite intervalos arbitrários.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Garantir consistência em cenários concorrentes utilizando <see cref="SemaphoreSlim"/>.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Cancelar requisições obsoletas quando o usuário altera rapidamente o termo de busca.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Implementar estratégias de retry controlado para lidar com falhas pontuais da API.
    /// </description>
    /// </item>
    /// </list>
    /// </para>
    ///
    /// <para>
    /// <b>Estratégia de cache:</b>
    /// <list type="bullet">
    /// <item>
    /// <description>
    /// Os itens são armazenados em um <see cref="ConcurrentDictionary{TKey, TValue}"/>,
    /// onde a chave representa o índice absoluto do item na lista total.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// O cache mantém apenas uma janela deslizante de páginas próximas à posição atual,
    /// evitando crescimento ilimitado de memória.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Quando os itens solicitados já estão totalmente no cache, nenhuma chamada
    /// ao backend é realizada.
    /// </description>
    /// </item>
    /// </list>
    /// </para>
    ///
    /// <para>
    /// <b>Controle de concorrência:</b>
    /// <list type="bullet">
    /// <item>
    /// <description>
    /// O semáforo (<see cref="fetchLock"/>) impede que múltiplas requisições
    /// simultâneas preencham o cache com dados duplicados.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Antes de buscar dados, o cache é reavaliado dentro do lock para evitar
    /// requisições redundantes.
    /// </description>
    /// </item>
    /// </list>
    /// </para>
    ///
    /// <para>
    /// <b>Cancelamento:</b>
    /// <list type="bullet">
    /// <item>
    /// <description>
    /// Um <see cref="CancellationTokenSource"/> é reutilizado durante a busca atual.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Ao detectar alteração no termo de busca, todas as requisições em andamento
    /// são canceladas imediatamente.
    /// </description>
    /// </item>
    /// </list>
    /// </para>
    ///
    /// <para>
    /// <b>Tolerância a falhas:</b>
    /// <list type="bullet">
    /// <item>
    /// <description>
    /// Falhas pontuais em páginas individuais não interrompem completamente o fluxo.
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// O método tenta recuperar páginas ausentes quando existem registros conhecidos
    /// (<c>TotalCount &gt; 0</c>).
    /// </description>
    /// </item>
    /// <item>
    /// <description>
    /// Em último caso, retorna um subconjunto parcial para não bloquear a renderização
    /// do componente.
    /// </description>
    /// </item>
    /// </list>
    /// </para>
    ///
    /// <para>
    /// Este método nunca lança exceções para o consumidor (<see cref="Virtualize"/>),
    /// garantindo estabilidade da UI mesmo em cenários adversos.
    /// </para>
    /// </remarks>
    private async ValueTask<ItemsProviderResult<SectorBasicListDTO>> LoadSectorsVirtualizedAsync(ItemsProviderRequest request)
    {
        // Garante valores mínimos válidos vindos do Virtualize
        int start = Math.Max(request.StartIndex, 0);
        int count = Math.Max(request.Count, 1);

        // Termo de busca normalizado (evita null e espaços)
        string search = (searchTerm ?? string.Empty).Trim();

        // Atualiza indicadores visuais de estado da UI
        isLoadingItems = true;
        loadError = false;
        noItems = false;
        await InvokeAsync(StateHasChanged);

        // ============================================================
        // DETECÇÃO DE MUDANÇA NO TERMO DE BUSCA
        // ============================================================
        // Caso o termo atual seja diferente do anterior, invalida todo
        // o cache e cancela requisições pendentes.
        if (previousSearch != search)
        {
            // Limpa cache quando os dados antigos não são mais válidos
            indexCache.Clear();
            totalItemCount = 0;

            // Atualiza o termo de referência
            previousSearch = search;

            // Cancela qualquer busca em andamento
            if (fetchCts is { IsCancellationRequested: false })
            {
                try 
                { 
                    fetchCts.Cancel(); 
                } 
                catch { }
            }

            // Libera o token anterior
            fetchCts?.Dispose();
            fetchCts = null;
        }

        // ============================================================
        // VERIFICAÇÃO RÁPIDA DE CACHE (SEM LOCK)
        // ============================================================
        // Primeiro tenta atender a solicitação apenas com dados em cache,
        // evitando custo de lock e chamadas ao backend.
        bool allCached = true;
        var resultItems = new List<SectorBasicListDTO>(count);

        for (int i = 0; i < count; i++)
        {
            if (indexCache.TryGetValue(start + i, out var item))
            {
                resultItems.Add(item);
            }
            else
            {
                allCached = false;
                break;
            }
        }

        // Se todos os itens solicitados já estão em cache, retorna imediatamente
        if (allCached)
        {
            isLoadingItems = false;
            noItems = (totalItemCount == 0);
            await InvokeAsync(StateHasChanged);
            return new ItemsProviderResult<SectorBasicListDTO>(resultItems, totalItemCount);
        }

        // ============================================================
        // CONTROLE DE CONCORRÊNCIA (LOCK)
        // ============================================================
        // Evita múltiplas requisições concorrentes buscando as mesmas páginas
        await fetchLock.WaitAsync();
        try
        {
            // Revalida o cache agora dentro do lock, pois outro fetch
            // pode ter sido concluído
            allCached = true;
            resultItems.Clear();

            for (int i = 0; i < count; i++)
            {
                if (indexCache.TryGetValue(start + i, out var item))
                    resultItems.Add(item);
                else
                {
                    allCached = false;
                    break;
                }
            }

            if (allCached)
            {
                isLoadingItems = false;
                noItems = (totalItemCount == 0);
                await InvokeAsync(StateHasChanged);
                return new ItemsProviderResult<SectorBasicListDTO>(resultItems, totalItemCount);
            }

            // ============================================================
            // ALINHAMENTO DE PAGINAÇÃO COM O BACKEND
            // ============================================================
            // Ajusta o índice inicial para o início da página da API
            int fetchStart = (start / ApiPageSize) * ApiPageSize;
            int pageIndex = fetchStart / ApiPageSize;

            // Calcula quantas páginas são necessárias para cobrir
            // o intervalo solicitado pelo Virtualize
            int neededItems = (start + count) - fetchStart;
            int requiredPages = Math.Max(1, (int)Math.Ceiling(neededItems / (double)ApiPageSize));

            // Limita o número máximo de páginas buscadas
            int fetchTake = requiredPages * ApiPageSize;
            fetchTake = Math.Min(fetchTake, ApiPageSize * MaxCachedPages);

            // Inicializa token de cancelamento se necessário
            fetchCts ??= new CancellationTokenSource();
            var ct = fetchCts.Token;

            // ============================================================
            // BUSCA DAS PÁGINAS NO BACKEND
            // ============================================================
            try
            {
                for (int p = pageIndex; p < pageIndex + requiredPages; p++)
                {
                    if (ct.IsCancellationRequested)
                        break;

                    try
                    {
                        var pageResult = await SectorService.GetSectorsBySelection(p * ApiPageSize, ApiPageSize, search, ct);

                        if (pageResult?.Items != null)
                        {
                            totalItemCount = pageResult.TotalCount;
                            int pageBase = p * ApiPageSize;
                            int ridx = 0;

                            var pageItems = pageResult.Items.ToList();

                            // Armazena os itens no cache com índice absoluto
                            foreach (var item in pageItems)
                            {
                                int absoluteIndex = pageBase + ridx;
                                indexCache.TryAdd(absoluteIndex, item);
                                ridx++;
                            }
                        }
                    }
                    catch (OperationCanceledException) when (ct.IsCancellationRequested)
                    {
                        break;
                    }
                    catch
                    {
                        // Falha em uma página não interrompe o fluxo
                        loadError = true;
                    }
                }
            }
            catch
            {
                loadError = true;
            }

            // ============================================================
            // CONTROLE DE TAMANHO DO CACHE
            // ============================================================
            // Remove páginas antigas mantendo uma janela próxima ao índice atual
            int maxCachedItems = ApiPageSize * MaxCachedPages;

            if (indexCache.Count > maxCachedItems)
            {
                var keysToKeep = Enumerable
                    .Range(Math.Max(0, start - ApiPageSize), maxCachedItems)
                    .ToHashSet();

                var keysToRemove = indexCache.Keys
                    .Where(k => !keysToKeep.Contains(k))
                    .ToList();

                foreach (var k in keysToRemove)
                    indexCache.TryRemove(k, out _);
            }

            // ============================================================
            // RETRY CONTROLADO CASO O CACHE ESTEJA INCOMPLETO
            // ============================================================
            bool hasKnownItems = totalItemCount > 0;

            if (hasKnownItems && !indexCache.ContainsKey(start))
            {
                try
                {
                    var retryResult = await SectorService.GetSectorsBySelection(pageIndex * ApiPageSize, ApiPageSize, search, ct);

                    if (retryResult?.Items != null)
                    {
                        int ridx = 0;
                        foreach (var item in retryResult.Items)
                        {
                            int absoluteIndex = fetchStart + ridx;
                            indexCache.TryAdd(absoluteIndex, item);
                            ridx++;
                        }
                    }
                }
                catch
                {
                    loadError = true;
                }
            }

            // ============================================================
            // CONSTRUÇÃO DA LISTA FINAL A PARTIR DO CACHE
            // ============================================================
            // Nesta etapa, o método tenta montar a lista de resposta utilizando
            // exclusivamente os dados já disponíveis no cache.
            //
            // A montagem é sequencial, iniciando no índice absoluto solicitado
            // pelo Virtualize (start) e avançando até atingir a quantidade
            // desejada (count).
            //
            // Caso algum índice não esteja presente no cache, a construção
            // é interrompida imediatamente para evitar retornar itens fora
            // de ordem ou inconsistentes.
            var finalList = new List<SectorBasicListDTO>();

            for (int i = 0; i < count; i++)
            {
                if (indexCache.TryGetValue(start + i, out var it))
                    finalList.Add(it);
                else
                    break;
            }

            // ============================================================
            // RETRY DIRECIONADO QUANDO O CACHE NÃO POSSUI O ÍNDICE INICIAL
            // ============================================================
            // Se nenhum item pôde ser montado, mas o backend indica que
            // existem registros além do índice solicitado (totalItemCount > start),
            // significa que o cache está desalinhado ou incompleto.
            //
            // Este cenário pode ocorrer devido a:
            // - Cancelamento de requisições anteriores
            // - Falha parcial em páginas específicas
            // - Mudança rápida de termo de busca
            //
            // Nesse caso, é feita uma tentativa controlada de recuperar
            // especificamente a página que contém o índice inicial solicitado.
            if (finalList.Count == 0 && totalItemCount > start)
            {
                // Determina a página da API correspondente ao índice inicial
                int startPage = fetchStart / ApiPageSize;

                // Realiza até duas tentativas para evitar loops infinitos
                for (int attempt = 0; attempt < 2 && finalList.Count == 0; attempt++)
                {
                    try
                    {
                        var pageResult = await SectorService.GetSectorsBySelection(startPage * ApiPageSize, ApiPageSize, search, fetchCts?.Token ?? CancellationToken.None);
                        if (pageResult?.Items != null)
                        {
                            int ridx = 0;
                            // Insere os itens retornados no cache utilizando
                            // índices absolutos alinhados ao backend
                            foreach (var item in pageResult.Items)
                            {
                                int absoluteIndex = fetchStart + ridx;
                                indexCache.TryAdd(absoluteIndex, item);
                                ridx++;
                            }

                            // Reconstrói a lista final após atualização do cache
                            finalList.Clear();
                            for (int i = 0; i < count; i++)
                            {
                                if (indexCache.TryGetValue(start + i, out var it))
                                    finalList.Add(it);
                                else
                                    break;
                            }
                        }
                    }
                    catch
                    {
                        // Falhas nesta etapa não interrompem o fluxo,
                        // apenas sinalizam erro para a UI
                        loadError = true;
                    }

                    // Pequeno atraso entre tentativas para permitir
                    // liberação de recursos e evitar pressão na API
                    if (finalList.Count == 0)
                        await Task.Delay(50);
                }
            }

            // ============================================================
            // RECUPERAÇÃO DE "BURACOS" NO CACHE DENTRO DA JANELA SOLICITADA
            // ============================================================
            // Mesmo quando parte dos itens já foi obtida, o cache pode conter
            // páginas ausentes dentro da janela [start, start + count).
            //
            // Este bloco identifica quais páginas da API intersectam a janela
            // solicitada e verifica se alguma delas não possui nenhum item
            // em cache.
            //
            // Apenas páginas totalmente ausentes são buscadas novamente,
            // evitando requisições redundantes.
            if (hasKnownItems && finalList.Count < count)
            {
                // Determina o intervalo de páginas afetadas pela janela solicitada
                int windowStartPage = fetchStart / ApiPageSize;
                int windowEndPage = ((start + count - 1) / ApiPageSize);

                var missingPages = new List<int>();

                for (int p = windowStartPage; p <= windowEndPage; p++)
                {
                    int pageBaseIndex = p * ApiPageSize;

                    // Verifica se existe pelo menos um item da página no cache
                    bool pageHasAny = Enumerable.Range(pageBaseIndex, ApiPageSize).Any(i => indexCache.ContainsKey(i));

                    // Se nenhum item da página estiver em cache,
                    // ela é marcada para recuperação
                    if (!pageHasAny)
                        missingPages.Add(p);
                }

                // Limita o número de tentativas para evitar
                // explosão de chamadas ao backend
                int maxRetries = Math.Min(3, missingPages.Count);

                for (int i = 0; i < maxRetries; i++)
                {
                    int pageToFetch = missingPages[i];
                    try
                    {
                        var pageResult = await SectorService.GetSectorsBySelection(pageToFetch * ApiPageSize, ApiPageSize, search, ct);
                        if (pageResult?.Items != null)
                        {
                            int ridx = 0;
                            int pageBase = pageToFetch * ApiPageSize;

                            // Armazena os itens da página ausente no cache
                            foreach (var item in pageResult.Items)
                            {
                                int absoluteIndex = pageBase + ridx;
                                indexCache.TryAdd(absoluteIndex, item);
                                ridx++;
                            }
                        }
                    }
                    catch
                    {
                        // Falha em página individual não invalida
                        // os dados já existentes no cache
                        loadError = true;
                    }
                }

                // ========================================================
                // RECONSTRUÇÃO FINAL APÓS PREENCHIMENTO DOS BURACOS
                // ========================================================
                // Após a tentativa de recuperação das páginas ausentes,
                // a lista final é montada novamente para refletir
                // o estado mais recente do cache.
                finalList.Clear();

                for (int i = 0; i < count; i++)
                {
                    if (indexCache.TryGetValue(start + i, out var it))
                        finalList.Add(it);
                    else
                        break;
                }
            }

            // ============================================================
            // FINALIZAÇÃO DO ESTADO DA UI
            // ============================================================
            isLoadingItems = false;
            noItems = (totalItemCount == 0);

            if (noItems && !loadError)
                await InvokeAsync(StateHasChanged);

            return new ItemsProviderResult<SectorBasicListDTO>(finalList, totalItemCount);
        }
        finally
        {
            // Libera o lock independentemente do resultado
            fetchLock.Release();
        }
    }
}