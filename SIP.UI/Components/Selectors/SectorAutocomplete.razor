@using SIP.UI.Domain.DTOs.Sectors.Pagination
@using SIP.UI.Domain.Services.Sectors
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using System.Threading

@implements IDisposable

@inject SectorService SectorService

<MudTextField @bind-Value="searchTerm"
              Label="Setor"
              Variant="Variant.Outlined"
              Adornment="Adornment.End"
              AdornmentIcon="@(showList? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)"
              AdornmentColor="Color.Inherit"
              @onclick="TogglePopover"
              Clearable="true"
              OnClearButtonClick="ClearSelection"
              ReadOnly="false"
              Immediate="true"
              @onkeyup="@((e) => OnSearchTermInput(e))" />

<MudPopover Open="showList"
            AnchorOrigin="Origin.BottomLeft"
            TransformOrigin="Origin.TopLeft"
            Class="sector-autocomplete-popover">

    <div class="sector-autocomplete-scroll-container">
        <Virtualize TItem="SectorBasicListDTO"
                    ItemsProvider="LoadSectorsVirtualizedAsync"
                    OverscanCount="2"
                    @key="virtualizeKey">

            <ItemContent Context="sector">
                <div class="pa-2 mud-ripple" @onclick="(() => SelectItem(sector))">
                    @sector.Name (@sector.Acronym)
                </div>
            </ItemContent>
        </Virtualize>
    </div>
</MudPopover>

@code {
    private string? searchTerm;
    private bool showList = false;
    private SectorBasicListDTO? lastSelectedValue;
    private Guid virtualizeKey = Guid.NewGuid();
    private Timer? searchTimer;
    private readonly int debounceDelay = 300; // 300ms é um bom padrão para debounce

    [Parameter]
    public SectorBasicListDTO? Value { get; set; }

    [Parameter]
    public EventCallback<SectorBasicListDTO?> ValueChanged { get; set; }

    public void Dispose() => searchTimer?.Dispose();

    protected override void OnParametersSet()
    {
        if (Value != null && Value != lastSelectedValue)
        {
            searchTerm = $"{Value.Name} ({Value.Acronym})";
            lastSelectedValue = Value;
        }
        else if (Value == null && lastSelectedValue != null)
        {
            searchTerm = null;
            lastSelectedValue = null;
        }
    }

    private void TogglePopover()
    {
        showList = !showList;
        // Força a atualização APENAS ao ABRIR, garantindo que o filtro digitado seja lido
        if (showList)
        {
            virtualizeKey = Guid.NewGuid();
        }
        StateHasChanged();
    }

    private void SelectItem(SectorBasicListDTO selectedSector)
    {
        searchTerm = $"{selectedSector.Name} ({selectedSector.Acronym})";
        showList = false;
        lastSelectedValue = selectedSector;
        ValueChanged.InvokeAsync(selectedSector);
    }

    private void ClearSelection()
    {
        searchTerm = null;
        lastSelectedValue = null;
        ValueChanged.InvokeAsync(null);
        showList = false;

        // Limpa e recarrega a lista sem filtro
        virtualizeKey = Guid.NewGuid();
        StateHasChanged();
    }

    private void OnSearchTermInput(KeyboardEventArgs e)
    {
        // 1. Abre a lista
        showList = true;

        // 2. Limpa o timer anterior
        searchTimer?.Dispose();

        // 3. Inicia debounce (300ms)
        searchTimer = new Timer(async _ =>
        {
            // Usa InvokeAsync para voltar ao contexto de UI Thread
            await InvokeAsync(() =>
            {
                // CRÍTICO: Força o Virtualize a reiniciar a busca com o searchTerm atualizado.
                virtualizeKey = Guid.NewGuid();
                StateHasChanged();
            });
        }, null, debounceDelay, Timeout.Infinite);
    }

    private async ValueTask<ItemsProviderResult<SectorBasicListDTO>> LoadSectorsVirtualizedAsync(ItemsProviderRequest request)
    {
        // Define o tamanho da página. O Virtualize pede o que ele precisa (request.Count).
        int pageSize = Math.Max(request.Count, 10);
        int pageNumber = (request.StartIndex / pageSize) + 1;

        // Lê o 'searchTerm' atualizado.
        string search = (searchTerm ?? string.Empty).Trim();

        var result = await SectorService.GetSectorsBySelection(pageNumber, pageSize, search);

        if (result == null || result.Items == null)
            return new ItemsProviderResult<SectorBasicListDTO>(Array.Empty<SectorBasicListDTO>(), 0);

        return new ItemsProviderResult<SectorBasicListDTO>(result.Items, result.TotalCount);
    }
}