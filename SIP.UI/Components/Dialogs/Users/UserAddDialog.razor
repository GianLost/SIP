@using MudBlazor
@using SIP.UI.Components.Passwords
@using SIP.UI.Components.Selectors
@using SIP.UI.Domain.DTOs.Default.Pagination
@using SIP.UI.Domain.DTOs.Sectors.Pagination
@using SIP.UI.Domain.DTOs.Sectors.Request
@using SIP.UI.Domain.DTOs.Users.Request
@using SIP.UI.Domain.DTOs.Users
@using SIP.UI.Domain.Services.Sectors
@using SIP.UI.Domain.Enums
@using SIP.UI.Models.Sectors
@using SIP.UI.Models.Users

@inject SectorService _sectorServices
@inject ISnackbar Snackbar

<MudDialog Style="width:600px">

    <TitleContent>
        <MudStack Class="page-title">
            <MudText Typo="Typo.h6">USUÁRIOS <span>| CRIAR</span></MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>

        <div class="dialog-content">
            <MudForm
                @ref="form" 
                @bind-IsValid="isValid" 
                ErrorsChanged="OnErrorsChanged">

                <MudGrid Spacing="5">

                    <MudItem xs="6">
                        <MudTextField @bind-Value="maspString"
                                      Counter="50"
                                      Label="Masp"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.FormatListNumbered"
                                      Required="true"
                                      RequiredError="O MASP é obrigatório!"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Clearable="true"
                                      Placeholder="Ex: 12345"
                                      HelperText="Matrícula do usuário."
                                      MaxLength="50"
                                      OnBlur="SyncMaspToModel" />
                    </MudItem>

                    <MudItem xs="6">
                        <MudTextField @bind-Value="User.Name"
                                      Counter="150"
                                      Label="Name" 
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.PeopleOutline" 
                                      Required="true" 
                                      RequiredError="O nome é obrigatório!" 
                                      Variant="Variant.Outlined" 
                                      Immediate="true"
                                      Clearable="true"
                                      MaxLength="150"
                                      Placeholder="Ex: Maria Souza de Assis"
                                      HelperText="Nome completo do usuário." />
                    </MudItem>

                    <MudItem xs="6">
                        <MudTextField @bind-Value="User.Login" 
                                      Counter="50"
                                      Label="Login" 
                                      Adornment="Adornment.End" 
                                      AdornmentIcon="@Icons.Material.Filled.People" 
                                      Required="true" 
                                      RequiredError="O login é obrigatório!" 
                                      Variant="Variant.Outlined" 
                                      Immediate="true"
                                      Clearable="true"
                                      MaxLength="50"
                                      Placeholder="Ex: maria.souza"
                                      HelperText="Nome de login do usuário." />
                    </MudItem>

                    <MudItem xs="6">
                        <MudTextField @bind-Value="User.Email" 
                                      Counter="200"
                                      Label="Email" 
                                      Adornment="Adornment.End" 
                                      AdornmentIcon="@Icons.Material.Filled.Email" 
                                      Required="true" 
                                      RequiredError="O email é obrigatório!" 
                                      Variant="Variant.Outlined" 
                                      Immediate="true"
                                      Clearable="true"
                                      MaxLength="200"
                                      Placeholder="Ex: maria@gmail.com"
                                      HelperText="Email do usuário." />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      Value="User.Password"
                                      ValueChanged="@(async (string v) => await OnPasswordValueChanged(v))"
                                      Counter="255"
                                      Label="Nova Senha"
                                      Variant="Variant.Outlined"
                                      InputType="@(showNewPassword ? InputType.Text : InputType.Password)"
                                      Required="true"
                                      RequiredError="A nova senha é obrigatória!"
                                      For="@(() => User.Password)"
                                      Validation="(string value) => ValidateNewPassword(value)"
                                      Adornment="Adornment.End"
                                      IconSize="Size.Small"
                                      AdornmentIcon="@(showNewPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="ToggleNewPasswordVisibility"
                                      Immediate="true"
                                      DebounceInterval="0"
                                      Clearable="true"
                                      MaxLength="255"
                                      Placeholder="Digite sua senha..."
                                      HelperText="Senha do usuário." />

                        <PasswordStrengthBar @bind-Password="passwordForStrength" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      Counter="255"
                                      @ref="confirmPasswordField"
                                      @bind-Value="ConfirmPassword"
                                      Label="Confirmar Senha"
                                      Variant="Variant.Outlined"
                                      InputType="@(showConfirmPassword? InputType.Text: InputType.Password)"
                                      Required="true"
                                      RequiredError="A confirmação de senha é obrigatória!"
                                      For="@(() => ConfirmPassword)"
                                      Validation="(string value) => ValidateConfirmPassword(value)"
                                      Adornment="Adornment.End"
                                      IconSize="Size.Small"
                                      AdornmentIcon="@(showConfirmPassword? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="ToggleConfirmPasswordVisibility"
                                      Immediate="true" 
                                      Clearable="true"
                                      MaxLength="255"
                                      Placeholder="Confirme sua senha..."
                                      HelperText="Confirme a senha de usuário." />
                    </MudItem>

                    <MudDivider Light="true" Class="ml-2 mt-4 mb-0"></MudDivider>

                    <MudItem xs="6">
                        <SectorAutocomplete @bind-Value="selectedSector" />
                    </MudItem>

                    <MudItem xs="6">
                        <MudSelect 
                            T="RoleEnum" 
                            Label="Função (Role)" 
                            @bind-Value="User.Role" 
                            Required="true" 
                            Dense="true" 
                            RequiredError="Selecione uma função!" 
                            Variant="Variant.Outlined"
                            HelperText="Nível de acesso do usuário.">
                            @foreach (RoleEnum role in Enum.GetValues(typeof(RoleEnum)))
                            {
                                <MudSelectItem Value="role">@GetRoleDisplayName(role)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>

            </MudForm>
        </div>

    </DialogContent>

    <DialogActions>
        <div class="dialog-actions">
            <MudButton OnClick="Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="!isValid"
                       Class="action-button">
                <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" />
                Salvar
            </MudButton>

            <MudButton OnClick="Cancel"
                       Color="Color.Secondary"
                       Variant="Variant.Text">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                Cancelar
            </MudButton>
        </div>
    </DialogActions>

</MudDialog>

@code {

    /// <summary>
    /// A instância do diálogo do MudBlazor para controlar as ações do diálogo.
    /// É injetada automaticamente pelo framework.
    /// </summary>
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UserCreateDTO User { get; set; } = new();

    private SectorBasicListDTO? selectedSector;
    private MudForm? form;

    private string? maspString;
    private bool showNewPassword;
    private bool showConfirmPassword;
    private string ConfirmPassword { get; set; } = string.Empty;

    private string passwordForStrength = default!;

    private MudTextField<string>? confirmPasswordField;

    private bool isValid;

    private void SyncMaspToModel()
    {
        if (int.TryParse(maspString, out int parsed))
            User.Masp = parsed;
        else
            User.Masp = 0; // ou deixar sem alterar
    }

    /// <summary>
    /// Valida o campo "Nova Senha".
    /// </summary>
    /// <param name="value">Valor digitado no campo de senha.</param>
    /// <returns>Mensagem de erro se inválido, string vazia se válido.</returns>
    private string? ValidateNewPassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "A nova senha é obrigatória.";
        return null;
    }

    /// <summary>
    /// Valida o campo "Confirmar Senha".
    /// </summary>
    /// <param name="value">Valor digitado no campo de confirmação.</param>
    /// <returns>Mensagem de erro se inválido, string vazia se válido.</returns>
    private string? ValidateConfirmPassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "A confirmação de senha é obrigatória.";
        if (value != User.Password)
            return "As senhas não conferem.";
        return null;
    }

    private async Task OnPasswordValueChanged(string v)
    {
        // atualiza o model real
        User.Password = v;

        // atualiza o "estado" que alimenta a barra
        passwordForStrength = v;

        // opcional: força validação do campo de confirmação
        await confirmPasswordField!.Validate();

        // força re-render
        StateHasChanged();
    }

    /// <summary>
    /// Alterna a visibilidade do campo "Nova Senha".
    /// </summary>
    private void ToggleNewPasswordVisibility() =>
        showNewPassword = !showNewPassword;

    /// <summary>
    /// Alterna a visibilidade do campo "Confirmar Senha".
    /// </summary>
    private void ToggleConfirmPasswordVisibility() =>
        showConfirmPassword = !showConfirmPassword;

    /// <summary>
    /// Retorna o nome de exibição amigável para cada função (RoleEnum).
    /// </summary>
    /// <param name="role">O valor do enum RoleEnum.</param>
    /// <returns>O nome legível da função correspondente.</returns>
    private string GetRoleDisplayName(RoleEnum role)
    {
        return role switch
        {
            RoleEnum.Common => "Leitor",
            RoleEnum.SectorManager => "Gestor",
            RoleEnum.Admin => "Administrador",
            _ => role.ToString() // Caso haja um novo enum sem mapeamento, exibe o nome padrão
        };
    }

    /// <summary>
    /// Executado ao inicializar o componente.
    /// Responsável por carregar os setores e preparar o formulário.
    /// </summary>
    protected override void OnInitialized()
    {
        maspString = User.Masp == 0 ? string.Empty : User.Masp.ToString();
        User.Password = string.Empty;

        StateHasChanged();
    }

    /// <summary>
    /// Executado sempre que a lista de erros do formulário é alterada.
    /// Atualiza a interface do usuário.
    /// </summary>
    private void OnErrorsChanged() => 
        StateHasChanged();

    /// <summary>
    /// Executa a validação do formulário.
    /// Se válido, atribui o setor selecionado ao usuário e
    /// fecha o diálogo retornando o objeto User.
    /// </summary>
    private async Task Submit()
    {
        await form!.Validate();

        if (isValid && selectedSector != null)
        {
            User.SectorId = selectedSector.Id;

            MudDialog.Close(DialogResult.Ok(User));
        }
    }

    /// <summary>
    /// Cancela a operação e fecha o diálogo sem salvar alterações.
    /// </summary>
    private void Cancel() => 
        MudDialog.Cancel();
}