@using SIP.UI.Domain.DTOs.Sectors.Pagination
@using SIP.UI.Domain.DTOs.Users.Configurations
@using SIP.UI.Components.Selectors
@using SIP.UI.Domain.DTOs.Sectors.Request
@using SIP.UI.Domain.Services.Sectors
@using SIP.UI.Domain.Services.Users
@using SIP.UI.Models.Users
@inject ISnackbar Snackbar
@inject SectorService _sectorServices
@inject UserService _userService

<MudDialog Style="width:450px">

    <TitleContent>
        <MudStack Class="page-title">
            <MudText Typo="Typo.h6">USUÁRIOS <span>| ALTERAR SETOR</span></MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">
            Alterar Setor para
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-semibold" Inline="true">
                @Users.Login
            </MudText>
        </MudText>

        <MudForm @ref="form" @bind-IsValid="isValid">

            <MudItem>
                <SectorAutocomplete @bind-Value="selectedSector" />
            </MudItem>

        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Class="justify-end pa-4">
            <MudButton OnClick="SubmitAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="!isValid" Class="mr-3">
                Salvar
            </MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="Cancel">
                Cancelar
            </MudButton>
        </MudStack>
    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter] 
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public User Users { get; set; } = new();

    private bool isValid;

    private MudForm? form;
    private SectorBasicListDTO? selectedSector;

    protected override async Task OnInitializedAsync()
    {
        if (Users?.SectorId == null || Users.SectorId == Guid.Empty)
            return;

        var sectorResult = 
            await _sectorServices.GetByIdAsync(Users.SectorId);

        var sector = sectorResult!.Items!.FirstOrDefault();

        if (sector != null)
        {
            selectedSector = new SectorBasicListDTO
            {
                Id = sector.Id,
                Name = sector.Name,
                Acronym = sector.Acronym
            };
        }
    }

    private async Task SubmitAsync()
    {
        if (form is null || !form.IsValid)
            return;

        // Verifica se o usuário selecionou um setor
        if (selectedSector is null || selectedSector.Id == Guid.Empty)
        {
            Snackbar.Add("Selecione um setor válido.", Severity.Warning);
            return;
        }

        var dto = new UserChangeSectorDTO
        {
            UserId = Users.Id,
            SectorId = selectedSector.Id
        };

        try
        {
            var updatedUser =
                await _userService.ChangeUserSectorAsync(dto);

            if (updatedUser != null)
            {
                MudDialog.Close(DialogResult.Ok(updatedUser));
            }
            else
            {
                Snackbar.Add("Usuário não encontrado.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao alterar setor: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() =>
        MudDialog.Cancel();
}