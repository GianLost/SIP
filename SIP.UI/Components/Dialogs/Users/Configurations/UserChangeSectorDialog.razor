@using SIP.UI.Domain.DTOs.Users.Configurations
@using SIP.UI.Domain.DTOs.Sectors.Request
@using SIP.UI.Domain.Services.Sectors
@using SIP.UI.Domain.Services.Users
@using SIP.UI.Models.Users
@inject ISnackbar Snackbar
@inject SectorService _sectorServices
@inject UserService _userService

<MudDialog Style="width:450px">

    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">
            Alterar Setor para
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-semibold" Inline="true">
                @Users.Login
            </MudText>
        </MudText>

        <MudForm @ref="form" @bind-IsValid="isValid">

            <MudItem>
                <MudAutocomplete T="SectorRequestDTO"
                                 Label="Setor"
                                 @bind-Value="selectedSector"
                                 SearchFunc="SearchSectors"
                                 For="() => selectedSector"
                                 Required="true"
                                 Dense="true"
                                 RequiredError="Selecione um setor!"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Normal"
                                 Class="mb-3"
                                 ToStringFunc="@(s => s == null ? string.Empty : $"{s.Acronym} - {s.Name}")"
                                 Clearable="true"
                                 Placeholder="Selecione o setor..."
                                 MaxItems="100" />
            </MudItem>

        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Class="justify-end pa-4">
            <MudButton OnClick="SubmitAsync" Color="Color.Primary" Variant="Variant.Filled" Disabled="!isValid" Class="mr-3">
                Salvar
            </MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="Cancel">
                Cancelar
            </MudButton>
        </MudStack>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm? form;
    private bool isValid;

    [Parameter]
    public User Users { get; set; } = new();

    private SectorRequestDTO? selectedSector;

    private List<SectorRequestDTO> _allSectors = new();

    /// <summary>
    /// Função de pesquisa para o autocomplete de setores.
    /// Filtra a lista de setores com base no valor de pesquisa do usuário.
    /// </summary>
    private Task<IEnumerable<SectorRequestDTO>> SearchSectors(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<SectorRequestDTO>>(_allSectors);

        var filtered = _allSectors
            .Where(s => s.Name.Contains(value, StringComparison.OrdinalIgnoreCase)
                     || s.Acronym.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult<IEnumerable<SectorRequestDTO>>(filtered);
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await _sectorServices.GetAllAsync();
        _allSectors = result?.Items?.ToList() ?? new List<SectorRequestDTO>();

        // Inicializa o selectedSector encontrando o DTO correspondente ao Users.SectorId (se existir)
        selectedSector = _allSectors.FirstOrDefault(s => s.Id == Users.SectorId);
    }

    private async Task SubmitAsync()
    {
        if (form is null || !form.IsValid)
            return;

        // Verifica se o usuário selecionou um setor
        if (selectedSector is null || selectedSector.Id == Guid.Empty)
        {
            Snackbar.Add("Selecione um setor válido.", Severity.Warning);
            return;
        }

        var dto = new UserChangeSectorDTO
        {
            UserId = Users.Id,
            SectorId = selectedSector.Id
        };

        try
        {
            var updatedUser =
                await _userService.ChangeUserSectorAsync(dto);

            if (updatedUser != null)
            {
                MudDialog.Close(DialogResult.Ok(updatedUser));
            }
            else
            {
                Snackbar.Add("Usuário não encontrado.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao alterar setor: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() =>
        MudDialog.Cancel();
}