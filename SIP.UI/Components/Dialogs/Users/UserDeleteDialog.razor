@using MudBlazor
@using SIP.UI.Components.Tooltips
@using SIP.UI.Domain.DTOs.Users.Pagination
@using SIP.UI.Domain.Services.Users
@using SIP.UI.Models.Sectors
@using SIP.UI.Models.Users

@inject UserService UserService

<MudDialog>

    <TitleContent>
        <MudStack Class="page-title">
            <MudText Typo="Typo.h6">USUÁRIOS <span>| EXCLUIR</span></MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>

        <div class="dialog-content no-copy">

            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Text"
                      Dense="true"
                      Class="alert-centered-icon mb-4"
                      Icon="@Icons.Material.Filled.ErrorOutline">
                <p style="margin: auto; text-align: justify;">
                    Você está prestes a <b>** EXCLUIR PERMANENTEMENTE **</b> o usuário: <b>@UserToDelete?.Name</b>.
                </p>
            </MudAlert>

            <MudPaper Class="pa-4 mb-4" Outlined="true" Square="true">

                <MudText Class="d-flex flex-row justify-content-between" Typo="Typo.h6">
                    <b>Usuário selecionado</b>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">

                        <AppTooltip 
                            Title="protocolos vinculados"
                            Description="Quantidade total de protocolos atualmente vinculados ao usuário selecionado."
                            Icon="@Icons.Material.Filled.Book" 
                            Placement="Placement.Right" 
                            Color="Color.Inherit">

                            <ChildContent>
                                <MudChip T="int"
                                         Color="Color.Primary"
                                         Variant="Variant.Filled"
                                         Size="Size.Medium"
                                         Icon="@Icons.Material.Filled.Book"
                                         Class="cursor-pointer fw-bold">
                                    @($": {ProtocolsCount}")
                                </MudChip>
                            </ChildContent>

                        </AppTooltip>

                    </MudStack>
                </MudText>

                <MudDivider Light="true" Class="my-1" />

                <MudText Typo="Typo.body2" Class="mt-2 mb-2">
                    <b>Nome:</b> @UserToDelete?.Name
                </MudText>

                <MudDivider Light="true" Class="my-1" />

                <MudText Typo="Typo.body2" Class="mt-2 mb-2">
                    <b>Login:</b> @UserToDelete?.Login
                </MudText>

                <MudDivider Light="true" Class="my-1" />

                <MudText Typo="Typo.body2" Class="mt-2 mb-2">
                    <b>Setor:</b> @UserToDelete?.Sector
                </MudText>

                <MudDivider Light="true" />
            </MudPaper>

            <MudAlert Severity="Severity.Warning"
                      Variant="Variant.Text"
                      Dense="true"
                      Class="alert mb-4"
                      Icon="@Icons.Material.Filled.WarningAmber">

                <p style="margin: auto; text-align: justify;">
                    <b>Atenção:</b> Esta ação não poderá ser desfeita.
                </p>

            </MudAlert>

            <MudDivider Light="true" Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2">
                Para confirmar a exclusão, digite o nome completo correspondente ao usuário: <b>@UserToDelete?.Name</b>
            </MudText>

            <MudTextField T="string"
                          Label="Confirmar exclusão"
                          Variant="Variant.Outlined"
                          @bind-Value="_confirmationText"
                          Margin="Margin.Normal"
                          Immediate="true"
                          Required="true"
                          RequiredError="Informe o nome do usuário para prosseguir."
                          HelperText="O texto deve ser idêntico ao nome do usuário acima." />
        </div>

    </DialogContent>

    <DialogActions>
        <div class="dialog-actions">

            <MudButton Color="Color.Error"
                       Variant="Variant.Filled"
                       OnClick="Submit"
                       Disabled="@(UserToDelete is null || !_isConfirmationValid)">
                <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" />
                Excluir
            </MudButton>

            <MudButton Color="Color.Secondary"
                       Variant="Variant.Text"
                       Class="action-button cancel-button"
                       OnClick="Cancel">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                Cancelar
            </MudButton>

        </div>
    </DialogActions>

</MudDialog>

@code {

    /// <summary>
    /// A instância do diálogo do MudBlazor para controlar as ações (fechar, confirmar, cancelar).
    /// É injetada automaticamente pelo framework.
    /// </summary>
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// O usuário que será excluído, recebido como parâmetro do componente pai.
    /// Contém as informações exibidas no diálogo de confirmação.
    /// </summary>
    [Parameter]
    public UserListItemDTO UserToDelete { get; set; } = new();

    [Parameter]
    public int ProtocolsCount { get; set; }

    private string _confirmationText = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (UserToDelete?.Id != null)
        {
            try
            {
                var protocols = await UserService.GetCreatedProtocolsByUserAsync(UserToDelete.Id);
                ProtocolsCount = protocols?.Count ?? 0;
            }
            catch
            {
                ProtocolsCount = 0;
            }
        }
    }

    private bool _isConfirmationValid =>
        _confirmationText.Trim().Equals($"{UserToDelete?.Name}", 
        StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Confirma a exclusão do usuário.
    /// Fecha o diálogo retornando um resultado positivo (true).
    /// </summary>
    private void Submit() => 
        MudDialog.Close(DialogResult.Ok(true));

    /// <summary>
    /// Cancela a exclusão e fecha o diálogo sem aplicar nenhuma alteração.
    /// </summary>
    private void Cancel() => 
        MudDialog.Cancel();

}