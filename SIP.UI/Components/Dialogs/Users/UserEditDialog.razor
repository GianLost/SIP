@using MudBlazor
@using SIP.UI.Components.Switches
@using SIP.UI.Domain.DTOs.Users
@using SIP.UI.Domain.Services.Sectors
@using SIP.UI.Domain.Enums
@using SIP.UI.Models.Sectors
@using SIP.UI.Models.Users

@inject ISnackbar Snackbar
@inject SectorService _sectorServices

<MudDialog Style="width:600px">

    <TitleContent>
        <MudStack Class="page-title">
            <MudText Typo="Typo.h6">USUÁRIOS <span>| EDITAR</span></MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>

        <div class="dialog-content">
            <MudForm @ref="form"
                     @bind-IsValid="isValid"
                     ErrorsChanged="OnErrorsChanged">

                <MudGrid Spacing="2">

                    <MudItem xs="6">
                        <MudTextField @bind-Value="maspString"
                                      Counter="50"
                                      Label="Masp"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.FormatListNumbered"
                                      Required="true"
                                      RequiredError="O MASP é obrigatório!"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Clearable="true"
                                      Placeholder="Ex: 12345"
                                      HelperText="Matrícula do usuário."
                                      MaxLength="50"
                                      OnBlur="SyncMaspToModel" />
                    </MudItem>

                    <MudItem xs="6">
                        <MudTextField @bind-Value="User.Name"
                                      Counter="150"
                                      Label="Name"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.PeopleOutline"
                                      Required="true"
                                      RequiredError="O nome é obrigatório!"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Clearable="true"
                                      MaxLength="150"
                                      Placeholder="Ex: Maria Souza de Assis"
                                      HelperText="Nome completo do usuário." />
                    </MudItem>

                    <MudItem xs="6">
                        <MudTextField @bind-Value="User.Login"
                                      Counter="50"
                                      Label="Login"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.People"
                                      Required="true"
                                      RequiredError="O login é obrigatório!"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Clearable="true"
                                      MaxLength="50"
                                      Placeholder="Ex: maria.souza"
                                      HelperText="Nome de login do usuário." />
                    </MudItem>

                    <MudItem xs="6">
                        <MudTextField @bind-Value="User.Email"
                                      Counter="200"
                                      Label="Email"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      Required="true"
                                      RequiredError="O email é obrigatório!"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Clearable="true"
                                      MaxLength="200"
                                      Placeholder="Ex: maria@gmail.com"
                                      HelperText="Email do usuário." />
                    </MudItem>

                    <MudItem xs="6">
                        <StatusToggle @bind-Value="User.Status" />
                    </MudItem>

                    <MudItem xs="6" Class="m-0">
                        <MudSelect T="RoleEnum"
                                   Label="Função (Role)"
                                   @bind-Value="User.Role"
                                   Required="true"
                                   Dense="true"
                                   RequiredError="Selecione uma função!"
                                   Variant="Variant.Outlined"
                                   HelperText="Nível de acesso do usuário.">
                            @foreach (RoleEnum role in Enum.GetValues(typeof(RoleEnum)))
                            {
                                <MudSelectItem Value="role">@GetRoleDisplayName(role)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>

            </MudForm>
        </div>

    </DialogContent>

    <DialogActions>
        <div class="dialog-actions">
            <MudButton OnClick="Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="!isValid"
                       Class="action-button">
                <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" />
                Salvar
            </MudButton>

            <MudButton OnClick="Cancel"
                       Color="Color.Secondary"
                       Variant="Variant.Text">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                Cancelar
            </MudButton>
        </div>
    </DialogActions>

</MudDialog>

@code {

    /// <summary>
    /// A instância do diálogo do MudBlazor para controlar o ciclo de vida do diálogo
    /// (fechar, cancelar ou retornar dados). É injetada automaticamente pelo framework.
    /// </summary>
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// O objeto de usuário que será editado. Este parâmetro é fornecido pelo componente pai.
    /// </summary>
    [Parameter]
    public UserUpdateDTO User { get; set; } = new();

    /// <summary>
    /// Referência ao formulário do MudBlazor, usada para disparar a validação manualmente.
    /// </summary>
    private MudForm? form;

    private string? maspString;

    /// <summary>
    /// Indica se o formulário é válido. Controla a habilitação do botão "Salvar".
    /// </summary>
    private bool isValid;

    private void SyncMaspToModel()
    {
        if (int.TryParse(maspString, out int parsed))
            User.Masp = parsed;
        else
            User.Masp = 0; // ou deixar sem alterar
    }

    /// <summary>
    /// Retorna o nome de exibição amigável para cada função (RoleEnum).
    /// </summary>
    /// <param name="role">O valor do RoleEnum.</param>
    /// <returns>O nome legível da função correspondente.</returns>
    private string GetRoleDisplayName(RoleEnum role)
    {
        return role switch
        {
            RoleEnum.Common => "Leitor",
            RoleEnum.SectorManager => "Gestor",
            RoleEnum.Admin => "Administrador",
            _ => role.ToString() // Caso surja um novo enum sem mapeamento, retorna o nome padrão
        };
    }

    protected override void OnInitialized()
    {
        maspString = User.Masp == 0 ? string.Empty : User.Masp.ToString();

        StateHasChanged();
    }

    /// <summary>
    /// Executado sempre que a lista de erros do formulário é alterada.
    /// Atualiza a interface do usuário.
    /// </summary>
    private void OnErrorsChanged() => 
        StateHasChanged();

    /// <summary>
    /// Executa a validação do formulário.
    /// Se for válido, fecha o diálogo e retorna o objeto <see cref="User"/> atualizado.
    /// </summary>
    private async Task Submit()
    {
        // Força a validação de todos os campos.
        await form!.Validate();

        // Se o formulário for válido e um setor tiver sido selecionado...
        if (isValid)
        {
            await form!.Validate();

            if (isValid)
                MudDialog.Close(DialogResult.Ok(User));
        }
    }

    /// <summary>
    /// Cancela a operação e fecha o diálogo sem salvar alterações.
    /// </summary>
    private void Cancel() => 
        MudDialog.Cancel();

}