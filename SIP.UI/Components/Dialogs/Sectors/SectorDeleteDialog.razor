@using SIP.UI.Domain.DTOs.Sectors.Pagination
@using MudBlazor

<MudDialog>

    <DialogContent>
        <div class="dialog-delete-content">

            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Text"
                      Dense="true"
                      Class="mb-3"
                      Icon="@Icons.Material.Filled.Error">
                Deseja excluir permanentemente o setor abaixo?
                Esta ação é <b>irreversível</b>.
            </MudAlert>

            <MudPaper Class="pa-4 mb-4" Outlined="true" Square="true">
                <MudStack Spacing="1">

                    <MudText Typo="Typo.subtitle1">
                        <b>Setor selecionado</b>
                    </MudText>

                    <MudDivider Light="true" Class="my-1" />

                    <MudText Class="paper-text" Typo="Typo.body1">
                        @SectorToDelete?.Acronym - @SectorToDelete?.Name
                    </MudText>

                </MudStack>
            </MudPaper>

            <MudAlert Severity="Severity.Warning"
                      Variant="Variant.Text"
                      Dense="true"
                      Icon="@Icons.Material.Filled.Warning">
                <b>Atenção:</b> Esta ação não poderá ser desfeita.
            </MudAlert>

        </div>
    </DialogContent>

    <DialogActions>
        <div class="dialog-delete-actions">

            <MudButton Color="Color.Error"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Class="action-button"
                       OnClick="Submit">
                Excluir
            </MudButton>

            <MudButton Color="Color.Secondary"
                       Variant="Variant.Outlined"
                       Class="action-button cancel-button"
                       OnClick="Cancel">
                Cancelar
            </MudButton>

        </div>
    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public SectorListItemDTO? SectorToDelete { get; set; }

    private void Submit() => 
        MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => 
        MudDialog.Cancel();
}