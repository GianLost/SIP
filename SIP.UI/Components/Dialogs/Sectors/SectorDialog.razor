@using MudBlazor
@using SIP.UI.Models.Sectors
@using System.Linq

<MudDialog>

    <TitleContent>
        @if (string.IsNullOrEmpty(Sector.Name))
        {
            <MudStack Class="page-title">
                <MudText Typo="Typo.h6">SECRETARIAS <span>| CRIAR</span></MudText>
            </MudStack>
        }
        else
        {
            <MudStack Class="page-title">
                <MudText Typo="Typo.h6">SECRETARIAS <span>| EDITAR</span></MudText>
            </MudStack>
        }
    </TitleContent>

    <DialogContent>

        <div class="dialog-content">

            <MudForm Class="sector-form" @ref="form" @bind-IsValid="isValid" ErrorsChanged="OnErrorsChanged">

                <MudGrid Spacing="5">

                    <MudItem xs="12">
                        <MudTextField @bind-Value="Sector.Name"
                                      Counter="150"
                                      Label="Nome da Secretaria"
                                      Adornment="Adornment.End" 
                                      AdornmentIcon="@Icons.Material.Filled.Info"
                                      Required="true"
                                      RequiredError="O nome da secretaria é obrigatório!"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Clearable="true"
                                      MaxLength="150"
                                      Placeholder="Ex: Secretaria Municipal de Saúde"
                                      HelperText="Nome completo da unidade." />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Sector.Acronym"
                                      Counter="20"
                                      Label="Sigla"
                                      Adornment="Adornment.End" 
                                      AdornmentIcon="@Icons.Material.Filled.Abc"
                                      Required="true"
                                      RequiredError="A sigla é obrigatória!"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Clearable="true"
                                      MaxLength="20"
                                      Placeholder="Ex: SESAU"
                                      HelperText="Acrônimo da unidade." />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Sector.Phone"
                                      Label="Telefone"
                                      Adornment="Adornment.End" 
                                      AdornmentIcon="@Icons.Material.Filled.Phone"
                                      Mask="@PhoneMask"
                                      Placeholder="(XX) XXXXX-XXXX"
                                      Required="true"
                                      RequiredError="O telefone é obrigatório!"
                                      Variant="Variant.Outlined"
                                      HelperText="Formato: (DDD) 9XXXX-XXXX ou (DDD) XXXX-XXXX" 
                                      Validation="@((string arg) => IsValidPhoneNumber(arg) ? null : "Telefone inválido. Use (DDD) 9XXXX-XXXX ou (DDD) XXXX-XXXX.")" />
                    </MudItem>

                </MudGrid>

            </MudForm>

        </div>

    </DialogContent>

    <DialogActions>
        <div class="dialog-actions">
            <MudButton OnClick="Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="!isValid"
                       Class="action-button">
                <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" />
                Salvar
            </MudButton>

            <MudButton OnClick="Cancel"
                       Color="Color.Secondary"
                       Variant="Variant.Text">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                Cancelar
            </MudButton>
        </div>
    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public BaseSector Sector { get; set; } = default!;

    private MudForm? form;
    private bool isValid = false;

    /// <summary>
    /// MultiMask para a entrada de telefone.
    /// Detecta e formata automaticamente para telefone celular (9 dígitos) ou fixo (8 dígitos).
    /// </summary>
    MultiMask PhoneMask = new MultiMask("(00) 00000-0000",
        new MaskOption("Celular", "(00) 00000-0000", @"^\(\d{2}\) 9"),
        new MaskOption("Fixo", "(00) 0000-0000", @"^\(\d{2}\) [2-8]")
    );

    /// <summary>
    /// Valida o formato do número de telefone (aceita 10 ou 11 dígitos numéricos).
    /// </summary>
    /// <param name="phone">String do telefone a ser validada.</param>
    /// <returns>True se o número for válido; caso contrário, False.</returns>
    private bool IsValidPhoneNumber(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return false;
        var digits = new string(phone.Where(char.IsDigit).ToArray());

        // Accepts (XX) XXXX-XXXX or (XX) 9XXXX-XXXX
        return digits.Length == 10 || digits.Length == 11;
    }

    private void OnErrorsChanged() =>
        StateHasChanged();

    private void Cancel() =>
        MudDialog.Cancel();

    private async Task Submit()
    {
        await form!.Validate();

        if (isValid)
            MudDialog.Close(DialogResult.Ok(Sector));
    }
}