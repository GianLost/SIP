@using MudBlazor
@using SIP.UI.Domain.DTOs.Protocols
@using SIP.UI.Domain.DTOs.Sectors.Request;
@using SIP.UI.Domain.DTOs.Users.Request;
@using SIP.UI.Domain.Services.Sectors
@using SIP.UI.Domain.Services.Users
@using SIP.UI.Domain.Enums
@using SIP.UI.Models.Protocols

@inject SectorService SectorService
@inject UserService UserService
@inject ISnackbar Snackbar

<MudDialog Style="width:600px">

    <DialogContent>

        <MudForm @ref="form" @bind-IsValid="isValid" Model="Protocol">

            <MudGrid Spacing="2">

                <!-- Assunto -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Protocol.Subject"
                                  Label="Assunto"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Normal" />
                </MudItem>

                <!-- Descrição -->
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Protocol.Description"
                                  Label="Descrição"
                                  Required="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Normal" />
                </MudItem>

                <!-- Usuário de origem -->
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="UserRequestDTO"
                                     @bind-Value="SelectedCreator"
                                     Label="Criado Por"
                                     SearchFunc="SearchUsers"
                                     Required="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Normal"
                                     Clearable="true"
                                     Placeholder="Pesquisar usuário de origem..."
                                     ToStringFunc="@(u => u?.Name)"
                                     MaxItems="int.MaxValue"
                                     Disabled="IsEdit" />
                </MudItem>

                <!-- Setor de origem (bloqueado) -->
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@(SelectedOriginSector?.Name ?? string.Empty)"
                                  Label="Setor de Origem"
                                  Disabled="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Normal" />
                </MudItem>

                <!-- Usuário de destino -->
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="UserRequestDTO"
                                     @bind-Value="SelectedDestinationUser"
                                     Label="Destinado a"
                                     SearchFunc="SearchUsers"
                                     Required="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Normal"
                                     Clearable="true"
                                     Placeholder="Pesquisar usuário de destino..."
                                     ToStringFunc="@(u => u?.Name)"
                                     MaxItems="int.MaxValue"
                                     Disabled="IsEdit" />
                </MudItem>

                <!-- Setor de destino (bloqueado) -->
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@(SelectedDestinationSector?.Name ?? string.Empty)"
                                  Label="Setor de Destino"
                                  Disabled="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Normal" />
                </MudItem>

                <!-- Status -->
                <MudItem xs="12" sm="6">
                    <MudSelect T="ProtocolStatus"
                               Label="Status"
                               @bind-Value="Protocol.Status"
                               Required="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Normal">
                        @foreach (ProtocolStatus status in Enum.GetValues(typeof(ProtocolStatus)))
                        {
                            <MudSelectItem Value="status">@GetStatusDisplayName(status)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <!-- Arquivar -->
                <MudItem xs="12" sm="6" Class="m-0">
                    <MudCheckBox Size="Size.Small"
                                 @bind-Value="Protocol.IsArchived"
                                 Color="@Color.Primary">
                        @(Protocol.IsArchived ? "Desarquivar" : "Arquivar")
                    </MudCheckBox>
                </MudItem>

            </MudGrid>

        </MudForm>

    </DialogContent>

    <DialogActions>
        <MudStack Row="true" Class="justify-end pa-4">
            <MudButton OnClick="Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="!isValid"
                       Class="mr-3">
                Salvar
            </MudButton>
            <MudButton Color="Color.Secondary"
                       Variant="Variant.Outlined"
                       OnClick="Cancel">
                Cancelar
            </MudButton>
        </MudStack>
    </DialogActions>

</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public BaseProtocol Protocol { get; set; } = default!;

    [Parameter]
    public bool IsEdit { get; set; }

    private MudForm? form;
    private bool isValid;

    private List<UserRequestDTO> AllUsers = new();
    private List<SectorRequestDTO> Sectors = new();

    private UserRequestDTO? _selectedCreator;
    private UserRequestDTO? _selectedDestinationUser;
    private SectorRequestDTO? SelectedOriginSector;
    private SectorRequestDTO? SelectedDestinationSector;

    private UserRequestDTO? SelectedCreator
    {
        get => _selectedCreator;
        set
        {
            if (_selectedCreator != value)
            {
                _selectedCreator = value;
                SelectedOriginSector = Sectors.FirstOrDefault(s => s.Id == _selectedCreator?.SectorId);
            }
        }
    }

    private UserRequestDTO? SelectedDestinationUser
    {
        get => _selectedDestinationUser;
        set
        {
            if (_selectedDestinationUser != value)
            {
                _selectedDestinationUser = value;
                SelectedDestinationSector = Sectors.FirstOrDefault(s => s.Id == _selectedDestinationUser?.SectorId);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var sectorsResult =
            await SectorService.GetAllAsync();

        Sectors = sectorsResult?.Items?.
            ToList() ?? new List<SectorRequestDTO>();

        var usersResult =
            await UserService.GetAllAsync();

        AllUsers = usersResult?.Items?
            .ToList() ?? new List<UserRequestDTO>();

        if (Protocol.CreatedById != Guid.Empty)
        {
            SelectedCreator = AllUsers.FirstOrDefault(u => u.Id == Protocol.CreatedById);
            SelectedOriginSector = Sectors.FirstOrDefault(s => s.Id == SelectedCreator?.SectorId);
        }

        if (Protocol.DestinationUserId != Guid.Empty)
        {
            SelectedDestinationUser = AllUsers.FirstOrDefault(u => u.Id == Protocol.DestinationUserId);
            SelectedDestinationSector = Sectors.FirstOrDefault(s => s.Id == SelectedDestinationUser?.SectorId);
        }

        StateHasChanged();
    }

    private Task<IEnumerable<UserRequestDTO>> SearchUsers(string value, CancellationToken cancellationToken)
    {
        IEnumerable<UserRequestDTO> users = AllUsers;

        if (!string.IsNullOrWhiteSpace(value))
        {
            users = users.Where(u => u.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(users);
    }

    private string GetStatusDisplayName(ProtocolStatus status) => status switch
    {
        ProtocolStatus.Open => "Em Aberto",
        ProtocolStatus.SentForReview => "Enviado",
        ProtocolStatus.Received => "Recebido",
        ProtocolStatus.UnderReview => "Em Análise",
        ProtocolStatus.Approved => "Aprovado",
        ProtocolStatus.Rejected => "Rejeitado",
        ProtocolStatus.CorrectionRequested => "Correção",
        ProtocolStatus.Finalized => "Finalizado",
        _ => status.ToString()
    };

    private async Task Submit()
    {
        await form!.Validate();

        if (!isValid) return;

        if (SelectedCreator is null || SelectedOriginSector is null || SelectedDestinationUser is null || SelectedDestinationSector is null)
        {
            Snackbar.Add("Por favor, selecione os usuários de origem e destino corretamente.", Severity.Warning);
            return;
        }

        Protocol.CreatedById = SelectedCreator.Id;
        Protocol.OriginSectorId = SelectedOriginSector.Id;
        Protocol.DestinationUserId = SelectedDestinationUser.Id;
        Protocol.DestinationSectorId = SelectedDestinationSector.Id;

        MudDialog.Close(DialogResult.Ok(Protocol));
    }

    private void Cancel() => MudDialog.Cancel();
}