@using MudBlazor

<MudProgressLinear Value="@_value"
                   Color="@_color"
                   Size="Size.Small"
                   Rounded="true"
                   Class="mt-2" />

<MudText Typo="Typo.caption" Color="@_color" Class="mt-1">
    Força da senha: @_label
</MudText>

@code {
    [Parameter] public string? Password { get; set; }
    [Parameter] public EventCallback<string?> PasswordChanged { get; set; }

    private int _value = 0;
    private Color _color = Color.Error;
    private string _label = "Digite uma senha";

    private string _previous = string.Empty;

    protected override void OnParametersSet()
    {
        // Só recalcula quando mudar de fato
        var pwd = Password ?? string.Empty;
        if (_previous != pwd)
        {
            _previous = pwd;
            Calculate(pwd);
        }
    }

    private void Calculate(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
        {
            _value = 0;
            _label = "Digite uma senha";
            _color = Color.Error;
            return;
        }

        bool hasMinLength = password.Length >= 8;
        bool hasLetter = password.Any(char.IsLetter);
        bool hasNumber = password.Any(char.IsDigit);
        bool hasSymbol = password.Any(ch => !char.IsLetterOrDigit(ch));

        // Barra baseada nas regras reais
        int score = 0;

        if (hasMinLength) score += 30;
        if (hasLetter) score += 25;
        if (hasNumber) score += 20;
        if (hasSymbol) score += 25;

        _value = score;

        // Estados visuais
        if (!hasMinLength)
        {
            _label = "Muito curta";
            _color = Color.Error;
        }
        else if (hasLetter && hasNumber && hasSymbol)
        {
            _label = "Forte";
            _color = Color.Success;
        }
        else
        {
            _label = "boa";
            _color = Color.Info;
        }
    }
}