@using MudBlazor
@using System.Text.RegularExpressions

<MudProgressLinear Value="@Value"
                   Color="@Color"
                   Size="Size.Small"
                   Rounded="true"
                   Class="mt-2" />

<MudText Typo="Typo.caption"
         Color="@Color"
         Class="mt-1">
    Força da senha: @Label
</MudText>

@code {

    /// <summary>
    /// Senha passada no componente.
    /// Este valor é utilizado para cálculo da força da senha.
    /// </summary>
    [Parameter]
    public string? Password { get; set; }

    /// <summary>
    /// Evento disparado quando a senha for alterada.
    /// Permite comunicação bidirecional entre componentes (two-way binding).
    /// </summary>
    [Parameter]
    public EventCallback<string?> PasswordChanged { get; set; }

    /// <summary>
    /// Valor atual da barra de progresso.
    /// Representa a pontuação calculada da força da senha (0 a 100).
    /// </summary>
    private int Value { get; set; }

    /// <summary>
    /// Cor aplicada na barra de progresso e no texto.
    /// Muda dinamicamente conforme a força da senha calculada.
    /// </summary>
    private Color Color { get; set; } = Color.Error;

    /// <summary>
    /// Texto exibido abaixo da barra indicando o nível da senha.
    /// </summary>
    private string Label { get; set; } = "Digite uma senha";

    /// <summary>
    /// Método do ciclo de vida do Blazor.
    /// Executado sempre que um parâmetro do componente for alterado.
    /// </summary>
    /// <remarks>
    /// Este método garante que a senha seja recalculada automaticamente
    /// sempre que seu valor for atualizado.
    /// </remarks>
    protected override void OnParametersSet() => Calculate();

    /// <summary>
    /// Realiza o cálculo completo da força da senha.
    /// Calcula a pontuação baseada em:
    /// - Comprimento da senha
    /// - Diversidade de caracteres
    /// </summary>
    /// <remarks>
    /// A pontuação total é limitada ao intervalo de 0 a 100.
    /// Após o cálculo, o método atualiza:
    /// <list type="bullet">
    /// <item><description>Valor da barra de progresso</description></item>
    /// <item><description>Rótulo exibido ao usuário</description></item>
    /// <item><description>Cor visual da interface</description></item>
    /// </list>
    /// </remarks>
    private void Calculate()
    {
        var password = Password ?? string.Empty;

        if (string.IsNullOrWhiteSpace(password))
        {
            Reset();
            return;
        }

        var score = CalculateLengthScore(password.Length)
                  + CalculateDiversityScore(password);

        Value = Math.Clamp(score, 0, 100);

        ApplyStatus(Value, password.Length);
    }

    /// <summary>
    /// Calcula a pontuação da senha considerando apenas seu comprimento.
    /// </summary>
    /// <param name="length">Quantidade de caracteres da senha.</param>
    /// <returns>
    /// Retorna a pontuação conforme faixas de tamanho definidas:
    /// <list type="table">
    /// <item><term>0-7</term><description>0 pontos</description></item>
    /// <item><term>8-10</term><description>10 pontos</description></item>
    /// <item><term>11-14</term><description>20 pontos</description></item>
    /// <item><term>15+</term><description>40 pontos</description></item>
    /// </list>
    /// </returns>
    private static int CalculateLengthScore(int length) => length switch
    {
        >= 15 => 40,
        >= 11 => 20,
        >= 8 => 10,
        _ => 0
    };

    /// <summary>
    /// Calcula a pontuação da senha considerando diversidade de caracteres.
    /// </summary>
    /// <param name="password">Senha a ser avaliada.</param>
    /// <returns>
    /// Retorna a soma da diversidade conforme os critérios:
    /// <list type="bullet">
    /// <item><description>Letra minúscula → 15 pontos</description></item>
    /// <item><description>Letra maiúscula → 15 pontos</description></item>
    /// <item><description>Número → 15 pontos</description></item>
    /// <item><description>Caractere especial → 15 pontos</description></item>
    /// </list>
    /// Pontuação máxima: 60 pontos.
    /// </returns>
    private static int CalculateDiversityScore(string password)
    {
        int score = 0;

        score += Has(password, "[a-z]") ? 15 : 0;
        score += Has(password, "[A-Z]") ? 15 : 0;
        score += Has(password, "[0-9]") ? 15 : 0;
        score += Has(password, "[^a-zA-Z0-9\\s]") ? 15 : 0;

        return score;
    }

    /// <summary>
    /// Verifica se a senha contém determinado padrão de caracteres.
    /// </summary>
    /// <param name="input">Texto base para avaliação.</param>
    /// <param name="pattern">Expressão regular a ser validada.</param>
    /// <returns>
    /// Retorna <see langword="true"/> se o padrão for encontrado; caso contrário, <see langword="false"/>.
    /// </returns>
    private static bool Has(string input, string pattern) =>
        Regex.IsMatch(input, pattern);

    /// <summary>
    /// Aplica rótulo, cor e valor final com base na pontuação e comprimento.
    /// </summary>
    /// <param name="value">Pontuação total calculada (0-100).</param>
    /// <param name="length">Tamanho da senha.</param>
    /// <remarks>
    /// Senhas menores que 8 caracteres sempre são classificadas como fracas,
    /// independentemente do score obtido.
    /// </remarks>
    private void ApplyStatus(int value, int length)
    {
        (Label, Color, Value) = (length, value) switch
        {
            ( < 8, _) => ("Muito Curta", Color.Error, Math.Min(value, 20)),

            (_, < 40) => ("Fraca", Color.Error, value),
            (_, < 60) => ("Razoável", Color.Warning, value),
            (_, < 80) => ("Boa", Color.Info, value),
            (_, < 100) => ("Forte", Color.Success, value),

            _ => ("Excelente!", Color.Success, 100)
        };
    }

    /// <summary>
    /// Reinicia o estado visual do componente.
    /// </summary>
    /// <remarks>
    /// Utilizado quando a senha não foi informada ou foi apagada.
    /// </remarks>
    private void Reset()
    {
        Value = 0;
        Label = "Digite uma senha";
        Color = Color.Error;
    }
}