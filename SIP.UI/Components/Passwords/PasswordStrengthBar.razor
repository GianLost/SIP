@using MudBlazor

<MudProgressLinear Value="@Value"
                   Color="@Color"
                   Size="Size.Small"
                   Rounded="true"
                   Class="mt-2" />

<MudText Typo="Typo.caption"
         Color="@Color"
         Class="mt-1">
    Força da senha: @Label
</MudText>

@code {

    [Parameter] public string? Password { get; set; }
    [Parameter] public EventCallback<string?> PasswordChanged { get; set; }

    private int Value { get; set; } = 0;
    private Color Color { get; set; } = Color.Error;
    private string Label { get; set; } = "Digite uma senha";

    protected override void OnParametersSet()
    {
        Calculate();
    }

    private void Calculate()
    {
        string password = Password ?? string.Empty;

        if (string.IsNullOrWhiteSpace(password))
        {
            Reset();
            return;
        }

        bool hasMinLength = password.Length >= 8;
        bool hasUpper = password.Any(char.IsUpper);
        bool hasLower = password.Any(char.IsLower);
        bool hasDigit = password.Any(char.IsDigit);
        bool hasSymbol = password.Any(ch => !char.IsLetterOrDigit(ch));

        int score = 0;

        if (hasMinLength) score += 20;
        if (hasUpper) score += 20;
        if (hasLower) score += 20;
        if (hasDigit) score += 20;
        if (hasSymbol) score += 20;

        Value = score;

        if (!hasMinLength)
        {
            Label = "Muito curta";
            Color = Color.Error;
        }
        else if (score <= 40)
        {
            Label = "Fraca";
            Color = Color.Error;
        }
        else if (score <= 60)
        {
            Label = "Boa";
            Color = Color.Warning;
        }
        else if (score <= 80)
        {
            Label = "Forte";
            Color = Color.Info;
        }
        else
        {
            Label = "Muito forte";
            Color = Color.Success;
        }
    }

    private void Reset()
    {
        Value = 0;
        Label = "Digite uma senha";
        Color = Color.Error;
    }
}